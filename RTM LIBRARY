-- قائمة منسدلة بحركة انسيابية ناعمة (خيارات بحجم لمس مريح)
function TabMethods:CreateDropdown(name, options, default, callback)
    options = options or {}
    local selected = nil
    if default ~= nil and table.find(options, default) then
        selected = default
    elseif options[1] ~= nil then
        selected = options[1]
    end

    local collapsed = 44
    local listHeight = math.min(#options * 26 + math.max(#options - 1, 0) * 4 + 10, 140)

    local container = CreateElement(self.Page, NextOrder(self), collapsed)
    container.ClipsDescendants = true
    CreateRowLabel(container, name, 152)
    RegisterSearchItem(self, name, container)

    local ddBtn = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 8),
        Size = UDim2.fromOffset(126, 30),
        BackgroundColor3 = Theme.ElementHover,
        Text = tostring(selected or "Select..."),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(ddBtn, 10)
    Stroke(ddBtn, Theme.Stroke, 0.88, 1)
    Create("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 26), Parent = ddBtn })
    BindHover(ddBtn, Theme.ElementHover, Theme.ElementBright, Theme.ElementPress)

    local arrow = Create("TextLabel", {
        Position = UDim2.new(1, -24, 0, 17),
        Size = UDim2.fromOffset(12, 12),
        BackgroundTransparency = 1,
        Text = "▼",
        TextSize = 9,
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamBold,
        ZIndex = 2,
        Parent = container,
    })

    local list = Create("ScrollingFrame", {
        Position = UDim2.new(0, 10, 0, collapsed),
        Size = UDim2.new(1, -20, 0, 0),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.10,
        BorderSizePixel = 0,
        Visible = false,
        ClipsDescendants = true,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.30,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 4,
        Parent = container,
    })
    Corner(list, 10)
    Stroke(list, Theme.Stroke, 0.90, 1)
    Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        Parent = list,
    })

    local expanded = false
    local function SetOpen(open)
        if expanded == open then return end
        expanded = open
        Tween(arrow, TI_Fast, { Rotation = open and 180 or 0, TextColor3 = open and Theme.AccentSoft or Theme.SubText })
        if open then
            list.Visible = true
            Tween(container, TI_Smooth, { Size = UDim2.new(1, 0, 0, collapsed + 8 + listHeight) })
            Tween(list, TI_Smooth, { Size = UDim2.new(1, -20, 0, listHeight) })
        else
            Tween(container, TI_Fast, { Size = UDim2.new(1, 0, 0, collapsed) })
            local tw = Tween(list, TI_Fast, { Size = UDim2.new(1, -20, 0, 0) })
            tw.Completed:Once(function()
                if not expanded then
                    list.Visible = false
                end
            end)
        end
    end

    local optionButtons = {}
    local function RefreshOptionColors()
        for option, button in pairs(optionButtons) do
            local isSelected = (option == selected)
            Tween(button, TI_Fast, {
                BackgroundColor3 = isSelected and Theme.Accent or Theme.ElementHover,
                BackgroundTransparency = isSelected and 0.28 or 0.25,
                TextColor3 = isSelected and Theme.Text or Theme.SubText,
            })
        end
    end

    for index, option in ipairs(options) do
        local optBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = Theme.ElementHover,
            BackgroundTransparency = 0.25,
            Text = tostring(option),
            TextColor3 = Theme.SubText,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = index,
            Parent = list,
        })
        Corner(optBtn, 8)
        Create("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = optBtn })
        optionButtons[option] = optBtn

        optBtn.MouseButton1Click:Connect(function()
            selected = option
            ddBtn.Text = tostring(option)
            RefreshOptionColors()
            SetOpen(false)
            if callback then
                local ok, err = pcall(callback, option)
                if not ok then warn("[RTM] Dropdown callback error: " .. tostring(err)) end
            end
        end)
    end

    ddBtn.MouseButton1Click:Connect(function()
        SetOpen(not expanded)
    end)
    RefreshOptionColors()

    local handle = {}
    handle.Container = container
    handle.Set = function(option)
        if table.find(options, option) then
            selected = option
            ddBtn.Text = tostring(option)
            RefreshOptionColors()
        end
    end
    handle.Get = function() return selected end
    RegisterConfigurable(self, name, "Dropdown", handle.Get, handle.Set)
    return handle
end

