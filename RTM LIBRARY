-- CreateTab(name, icon) — الأيقونة اختيارية (AssetId)
-- نمط RTM: زر شبح شفاف عند الخمول → غسلة بنفسجية + مؤشر pill عند التفعيل
function Aurora:CreateTab(name, icon)
    if self.Destroyed then return nil end
    name = tostring(name or "Tab")

    local tab = setmetatable({}, TabMethods)
    tab.Window = self
    tab.Name = name
    tab.Active = false
    tab._order = 0
    tab.SearchItems = {} -- فهرس البحث الجانبي لهذا التاب

    local iconId = ToAssetId(icon)

    tab.Button = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 0.55, -- نمط شبح هادئ
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = #self.Tabs + 1,
        Parent = self.TabContainer,
    })
    Corner(tab.Button, 10)
    tab.ButtonStroke = Stroke(tab.Button, Theme.Stroke, 0.94, 1)

    tab.Indicator = Create("Frame", { -- مؤشر pill بنفسجي للتاب النشط
        Size = UDim2.new(0, 4, 0, 18),
        Position = UDim2.new(0, 5, 0.5, -9),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = tab.Button,
    })
    Corner(tab.Indicator, 2)

    if iconId then
        tab.Icon = Create("ImageLabel", {
            Size = UDim2.fromOffset(16, 16),
            Position = UDim2.new(0, 16, 0.5, -8),
            BackgroundTransparency = 1,
            Image = iconId,
            ImageTransparency = 0.45,
            BorderSizePixel = 0,
            Parent = tab.Button,
        })
    end

    tab.Label = Create("TextLabel", {
        Size = UDim2.new(1, -(iconId and 52 or 30), 1, 0),
        Position = UDim2.new(0, iconId and 38 or 16, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = tab.Button,
    })

    tab.Page = Create("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.30,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, -- لا اختفاء للعناصر أبداً
        Parent = self.PageContainer,
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tab.Page,
    })

    local function Select()
        for _, t in ipairs(self.Tabs) do
            t.Active = false
            t.Page.Visible = false
            -- العودة لنمط الشبح الهادئ
            Tween(t.Button, TI_Fast, { BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.55 })
            Tween(t.Label, TI_Fast, { TextColor3 = Theme.SubText })
            Tween(t.ButtonStroke, TI_Fast, { Color = Theme.Stroke, Transparency = 0.94 })
            Tween(t.Indicator, TI_Fast, { BackgroundTransparency = 1 })
            if t.Icon then
                Tween(t.Icon, TI_Fast, { ImageTransparency = 0.45 })
            end
        end
        tab.Active = true
        self.ActiveTab = tab
        tab.Page.Visible = true
        -- الحالة النشطة: غسلة بنفسجية زجاجية + إطار ومؤشر بلون الـ Accent
        Tween(tab.Button, TI_Fast, { BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.80 })
        Tween(tab.Label, TI_Fast, { TextColor3 = Theme.Text })
        Tween(tab.ButtonStroke, TI_Fast, { Color = Theme.Accent, Transparency = 0.45 })
        Tween(tab.Indicator, TI_Fast, { BackgroundTransparency = 0 })
        if tab.Icon then
            Tween(tab.Icon, TI_Fast, { ImageTransparency = 0 })
        end
        if self._applySearch then
            self._applySearch() -- إعادة تطبيق فلتر البحث على التاب الجديد
        end
    end
    tab.Select = Select

    tab.Button.MouseButton1Click:Connect(function()
        if not tab.Active then
            Select()
        end
    end)
    tab.Button.MouseEnter:Connect(function()
        if not tab.Active then
            -- تحويم هادئ: لمسة بنفسجية خفيفة جداً
            Tween(tab.Button, TI_Fast, { BackgroundColor3 = Theme.ElementHover, BackgroundTransparency = 0.40 })
        end
    end)
    tab.Button.MouseLeave:Connect(function()
        if not tab.Active then
            Tween(tab.Button, TI_Fast, { BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.55 })
        end
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then
        Select()
    end

    return tab
end
