Aurora.TabMethods = {}

local function CreateBaseContainer(parent, name, height)
    local Container = Create("Frame", {Size = UDim2.new(1, -10, 0, height or 40), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.5, Parent = parent})
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Container })
    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.5, Parent = Container })
    if name then
        Create("TextLabel", {Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1, Text = name, TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})
    end
    return Container
end

function Aurora.TabMethods:CreateButton(name, callback)
    local Container = CreateBaseContainer(self.Page, name, 35)
    local Btn = Create("TextButton", {Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -70, 0.5, -10), BackgroundColor3 = Theme.Accent, Text = "Run", TextColor3 = Theme.Background, Font = Enum.Font.GothamBold, TextSize = 11, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Btn })
    Btn.MouseButton1Click:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 55, 0, 18)}):Play()
        task.wait(0.1); TweenService:Create(Btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 60, 0, 20)}):Play()
        if callback then callback() end
    end)
end

function Aurora.TabMethods:CreateToggle(name, default, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local State = default or false
    local Switch = Create("TextButton", {Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = State and Theme.Accent or Theme.Stroke, Text = "", Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Switch })
    local Knob = Create("Frame", {Size = UDim2.new(0, 16, 0, 16), Position = State and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Theme.Text, Parent = Switch})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })
    
    Switch.MouseButton1Click:Connect(function()
        State = not State
        if State then
            TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Stroke}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
        if callback then callback(State) end
    end)
end

function Aurora.TabMethods:CreateSlider(name, min, max, default, callback)
    local Container = CreateBaseContainer(self.Page, name, 50)
    local Hitbox = Create("TextButton", {Size = UDim2.new(1, -10, 1, 0), BackgroundTransparency = 1, Text = "", Parent = Container})
    
    local Track = Create("Frame", {Size = UDim2.new(1, -20, 0, 4), Position = UDim2.new(0, 10, 0, 35), BackgroundColor3 = Theme.Stroke, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })
    local Fill = Create("Frame", {Size = UDim2.new((default-min)/(max-min), 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = Track})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Fill })
    local Knob = Create("Frame", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -6, 0.5, -4), BackgroundColor3 = Theme.Text, Parent = Fill})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })
    
    local dragging = false
    local function updateSlider(input)
        local pos = input.Position.X - Track.AbsolutePosition.X
        local percent = math.clamp(pos / Track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * percent)
        Fill.Size = UDim2.new(percent, 0, 1, 0)
        if callback then callback(value) end
    end
    
    Hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    
    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    
    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end))
end

function Aurora.TabMethods:CreateDropdown(name, options, default, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local Selected = default or options[1]
    local Btn = Create("TextButton", {Size = UDim2.new(0, 100, 0, 20), Position = UDim2.new(1, -110, 0.5, -10), BackgroundColor3 = Theme.Glass, Text = Selected, TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 11, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Btn })
    
    local isOpen = false
    local listHeight = #options * 22 + 10
    local listFrame = Create("Frame", {Size = UDim2.new(1, -10, 0, listHeight), Position = UDim2.new(0, 5, 0, 40), BackgroundColor3 = Theme.Background, Visible = false, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = listFrame })
    Create("UIListLayout", { Padding = UDim.new(0, 2), Parent = listFrame })
    
    for _, opt in ipairs(options) do
        local optBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = Theme.Glass, Text = opt, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 11, Parent = listFrame})
        optBtn.MouseButton1Click:Connect(function()
            Selected = opt; Btn.Text = Selected
            if callback then callback(Selected) end
            isOpen = false; listFrame.Visible = false
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
        end)
    end
    
    Btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen; listFrame.Visible = isOpen
        TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, isOpen and (40 + listHeight) or 40)}):Play()
    end)
end

function Aurora.TabMethods:CreateInput(name, placeholder, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local Box = Create("TextBox", {Size = UDim2.new(0, 100, 0, 20), Position = UDim2.new(1, -110, 0.5, -10), BackgroundColor3 = Theme.Glass, Text = "", PlaceholderText = placeholder or "Enter...", TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 11, ClearTextOnFocus = false, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Box })
    Box.FocusLost:Connect(function(enterPressed)
        if callback then callback(Box.Text, enterPressed) end
    end)
end

function Aurora.TabMethods:CreateKeybind(name, defaultKey, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local currentKey = defaultKey
    local Btn = Create("TextButton", {Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -70, 0.5, -10), BackgroundColor3 = Theme.Glass, Text = tostring(currentKey.Name), TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 11, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Btn })
    
    local listening = false
    Btn.MouseButton1Click:Connect(function() listening = true; Btn.Text = "..." end)
    
    table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            listening = false; currentKey = input.KeyCode; Btn.Text = tostring(currentKey.Name)
        elseif input.KeyCode == currentKey and not processed then
            if callback then callback() end
        end
    end))
end

function Aurora.TabMethods:CreateColorpicker(name, defaultColor, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local color = defaultColor or Color3.fromRGB(255,255,255)
    local Swatch = Create("TextButton", {Size = UDim2.new(0, 30, 0, 20), Position = UDim2.new(1, -40, 0.5, -10), BackgroundColor3 = color, Text = "", Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Swatch })
    
    local palette = {Color3.fromRGB(255,0,0), Color3.fromRGB(0,255,0), Color3.fromRGB(0,0,255), Color3.fromRGB(255,255,0), Color3.fromRGB(0,255,255), Color3.fromRGB(255,255,255)}
    local isOpen = false
    local listFrame = Create("Frame", {Size = UDim2.new(0, 120, 0, 60), Position = UDim2.new(1, -130, 0, 40), BackgroundColor3 = Theme.Background, Visible = false, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = listFrame })
    Create("UIGridLayout", {CellSize = UDim2.new(0, 25, 0, 25), CellPadding = UDim2.new(0, 5, 0, 5), Parent = listFrame})
    
    for _, c in ipairs(palette) do
        local b = Create("TextButton", {BackgroundColor3 = c, Text = "", Parent = listFrame})
        Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = b })
        b.MouseButton1Click:Connect(function()
            color = c; Swatch.BackgroundColor3 = c
            if callback then callback(c) end
            isOpen = false; listFrame.Visible = false
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
        end)
    end
    
    Swatch.MouseButton1Click:Connect(function()
        isOpen = not isOpen; listFrame.Visible = isOpen
        TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, isOpen and 100 or 40)}):Play()
    end)
end

function Aurora.TabMethods:CreateSection(title)
    local Container = Create("Frame", {Size = UDim2.new(1, -10, 0, 25), BackgroundColor3 = Theme.Background, BackgroundTransparency = 1, Parent = self.Page})
    Create("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "  " .. title, TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})
    Create("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Stroke, Parent = Container})
end

function Aurora.TabMethods:CreateParagraph(text)
    local Container = Create("Frame", {Size = UDim2.new(1, -10, 0, 40), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.5, Parent = self.Page})
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Container })
    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.5, Parent = Container })
    Create("TextLabel", {Size = UDim2.new(1, -20, 0, 0), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.SubText, Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutomaticSize = Enum.AutomaticSize.Y, Parent = Container})
    Container.AutomaticSize = Enum.AutomaticSize.Y
end

return Aurora
