local function BuildSettingsTab(window)
    if window.Destroyed then return end
    local tab = window:AddTab("Settings", "⚙", true)

    tab:AddSection("Appearance")

    local presets = {
        { Name = "Charcoal",    Preview = Color3.fromRGB(0, 140, 255) },
        { Name = "Deep Violet", Preview = Color3.fromRGB(138, 43, 226) },
        { Name = "Neon Cyber",  Preview = Color3.fromRGB(0, 255, 198) },
        { Name = "RGB",         Preview = Color3.fromRGB(255, 0, 64) },
    }

    for _, preset in ipairs(presets) do
        local chip = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.25,
            Text = "          " .. preset.Name,
            TextColor3 = Theme.SubText,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = NextOrder(tab),
            Parent = tab.Container,
        })
        Corner(chip, 8)
        local chipStroke = Stroke(chip)
        local dot = Create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 10, 0.5, 0),
            Size = UDim2.fromOffset(8, 8),
            BackgroundColor3 = preset.Preview,
            BorderSizePixel = 0,
            Parent = chip,
        })
        Corner(dot, 4)
        BindTheme(window, chip, "BackgroundColor3", "Element")

        local function Refresh(accent)
            local active = window.CurrentTheme == preset.Name
            Tween(chip, TI_Fast, {
                BackgroundColor3 = active and Theme.ElementBright or Theme.Element,
                TextColor3 = active and accent or Theme.SubText,
            })
            Tween(chipStroke, TI_Fast, {
                Color = active and accent or Theme.Stroke,
                Transparency = active and 0.45 or 0.85,
            })
            Tween(dot, TI_Fast, { BackgroundColor3 = active and accent or preset.Preview })
        end
        table.insert(window._themeUpdaters, Refresh)
        Refresh(Theme.Accent)

        chip.MouseButton1Click:Connect(function()
            window:SetTheme(preset.Name)
        end)
        RegisterSearchItem(tab, preset.Name, chip)
    end

    tab:AddToggle("Acrylic / Transparency", window.AcrylicEnabled, function(value)
        window:SetAcrylic(value)
    end)

    tab:AddSection("Wallpaper")

    local row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        LayoutOrder = NextOrder(tab),
        Parent = tab.Container,
    })
    Corner(row, 8)
    Stroke(row)
    BindTheme(window, row, "BackgroundColor3", "Element")

    local input = Create("TextBox", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(1, -96, 0, 20),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "rbxassetid:// (image id)",
        PlaceholderColor3 = Theme.SubText,
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ClipsDescendants = true,
        TextTruncate = Enum.TextTruncate.AtEnd,
        BorderSizePixel = 0,
        Parent = row,
    })
    local applyBtn = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(72, 22),
        BackgroundColor3 = Theme.Accent,
        Text = "Apply",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = row,
    })
    Corner(applyBtn, 6)
    BindHover(applyBtn, Theme.Accent, Theme.AccentHover, Theme.AccentPress)
    BindTheme(window, applyBtn, "BackgroundColor3", "Accent")

    local function ApplyWallpaper()
        local text = string.gsub(input.Text, "%s", "")
        if text == "" then
            window:ClearBackgroundImage()
        else
            window:SetBackgroundImage(text, window._bgTransparency or 0)
        end
    end
    applyBtn.MouseButton1Click:Connect(ApplyWallpaper)
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then ApplyWallpaper() end
    end)
    RegisterSearchItem(tab, "Wallpaper", row)

    window.Registry["Settings/Wallpaper"] = {
        Type = "Wallpaper",
        Get = function() return window._bgAsset or "" end,
        Set = function(value)
            value = tostring(value or "")
            if value ~= "" then
                window:SetBackgroundImage(value, window._bgTransparency or 0)
            end
        end,
    }

    tab:AddSlider("Wallpaper Opacity", 0, 100,
        math.round((1 - (window._bgTransparency or 0)) * 100), function(pct)
            window:SetWallpaperTransparency(1 - pct / 100)
        end)

    tab:AddSlider("Dark Overlay", 0, 100, 40, function(pct)
        window:SetBackgroundOverlay(pct / 100)
    end)

    tab:AddToggle("Frosted Blur", window._frostEnabled, function(value)
        window:SetBackgroundFrost(value)
    end)

    tab:AddButton("Clear Wallpaper", function()
        input.Text = ""
        window:ClearBackgroundImage()
    end)
end

