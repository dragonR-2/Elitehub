            if not ok then warn("[RTM] Button callback error: " .. tostring(err)) end
        end
    end)

    return container
end

-- مفتاح تبديل بأسلوب iOS الحديث (بنفسجي عند التفعيل)
function TabMethods:CreateToggle(name, default, callback)
    local container = CreateElement(self.Page, NextOrder(self), 42)
    CreateRowLabel(container, name, 76)
    RegisterSearchItem(self, name, container)

    local state = default == true

    local switch = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(42, 24),
        BackgroundColor3 = state and Theme.Accent or Theme.ElementBright,
        BorderSizePixel = 0,
        Parent = container,
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = switch })
    local switchStroke = Stroke(switch, state and Theme.Accent or Theme.Stroke, state and 0.35 or 0.88, 1)
    if state then
        Gradient(switch, 90, Theme.Accent, Theme.AccentDeep) -- توهج بنفسجي عند التشغيل
    end

    local knob = Create("Frame", { -- مقبض أبيض بظل خفيف (iOS)
        Size = UDim2.fromOffset(18, 18),
        Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = switch,
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
    Create("UIStroke", { -- ظل داكن ناعم أسفل المقبض كأجهزة Apple
        Color = Color3.fromRGB(0, 0, 0),
        Thickness = 1,
        Transparency = 0.78,
        Parent = knob,
    })
    local knobScale = Create("UIScale", { Scale = 1, Parent = knob })

    -- الصف كامل قابل للضغط (تجربة لمس أفضل على الجوال)
    local hit = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
        Parent = container,
    })

    local function Render()
        if state then
            Tween(switch, TI_Fast, { BackgroundColor3 = Theme.Accent })
            Tween(switchStroke, TI_Fast, { Color = Theme.Accent, Transparency = 0.35 })
            Tween(knob, TI_Fast, { Position = UDim2.new(1, -21, 0.5, -9) })
        else
            Tween(switch, TI_Fast, { BackgroundColor3 = Theme.ElementBright })
            Tween(switchStroke, TI_Fast, { Color = Theme.Stroke, Transparency = 0.88 })
            Tween(knob, TI_Fast, { Position = UDim2.new(0, 3, 0.5, -9) })
        end
    end

    hit.MouseButton1Click:Connect(function()
        state = not state
        knobScale.Scale = 0.82 -- نبضة ضغط على المقبض
        Tween(knobScale, TI_Click, { Scale = 1 })
        Render()
        if callback then
            local ok, err = pcall(callback, state)
            if not ok then warn("[RTM] Toggle callback error: " .. tostring(err)) end
        end
    end)

    local handle = {}
    handle.Container = container
    handle.Set = function(value)
        value = value == true
        if value ~= state then
            state = value
            Render()
        end
    end
    handle.Get = function() return state end
    RegisterConfigurable(self, name, "Toggle", handle.Get, handle.Set)
    return handle
end

-- شريط تمرير نحيف وأنيق (تدرج بنفسجي + مقبض متوهج)
function TabMethods:CreateSlider(name, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    if max < min then
        min, max = max, min
    end
    default = math.clamp(tonumber(default) or min, min, max)

    local container = CreateElement(self.Page, NextOrder(self), 52)
    RegisterSearchItem(self, name, container)

    Create("TextLabel", {
        Size = UDim2.new(1, -122, 0, 16),
        Position = UDim2.new(0, 14, 0, 8),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = container,
    })

    local valueLabel = Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 8),
        Size = UDim2.fromOffset(90, 16),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Theme.AccentSoft,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = container,
    })

    local track = Create("Frame", { -- مسار نحيف 4px
        Size = UDim2.new(1, -28, 0, 4),
        Position = UDim2.new(0, 14, 1, -16),
        BackgroundColor3 = Theme.ElementBright,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(track, 2)

    local fill = Create("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    Corner(fill, 2)
    Gradient(fill, 0, Theme.Accent, Theme.AccentSoft) -- بنفسجي → فاتح أفقياً

    local knob = Create("Frame", { -- مقبض أبيض بحلقة بنفسجية متوهجة
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(13, 13),
        Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = track,
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
    Create("UIStroke", {
        Color = Theme.Accent,
        Thickness = 1.5,
        Transparency = 0.20,
        Parent = knob,
    })

    local useDecimals = (min % 1 ~= 0) or (max % 1 ~= 0) or (max - min) < 2
    local current = default

    local function SetValue(value, fire)
        current = math.clamp(value, min, max)
        local alpha = (current - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        if useDecimals then
            valueLabel.Text = tostring(math.round(current * 100) / 100)
        else
            valueLabel.Text = tostring(math.round(current))
        end
        if fire and callback then
            local ok, err = pcall(callback, current)
            if not ok then warn("[RTM] Slider callback error: " .. tostring(err)) end
        end
    end
    SetValue(default, false)

    local hit = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
        Parent = container,
    })

    local dragging = false
    local function UpdateFromX(xPosition)
        local rel = math.clamp(
            (xPosition - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        SetValue(min + (max - min) * rel, true)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            self.Page.ScrollingEnabled = false -- منع تمرير الصفحة أثناء السحب
            UpdateFromX(input.Position.X)
        end
    end)
    table.insert(self.Window.Connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromX(input.Position.X)
        end
    end))
    table.insert(self.Window.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                self.Page.ScrollingEnabled = true
            end
        end
    end))

    local handle = {}
    handle.Container = container
    handle.Set = function(value)
        SetValue(tonumber(value) or min, false)
    end
    handle.Get = function() return current end
    RegisterConfigurable(self, name, "Slider", handle.Get, handle.Set)
