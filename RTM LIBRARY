        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, 4),
        BackgroundColor3 = Theme.ElementHover,
        BorderSizePixel = 0,
        Parent = hitArea,
    })
    Corner(track, 2)
    local fill = Create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    Corner(fill, 2)
    BindTheme(window, fill, "BackgroundColor3", "Accent")
    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = hitArea,
    })
    Corner(knob, 6)

    local value = math.clamp(tonumber(default) or minValue, minValue, maxValue)
    local function Render()
        local alpha = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
        valueLabel.Text = string.format("%." .. precision .. "f", value)
    end
    local function SetValue(newValue, fire)
        newValue = tonumber(newValue) or value
        newValue = math.clamp(math.round(newValue / step) * step, minValue, maxValue)
        local changed = newValue ~= value
        value = newValue
        Render()
        if fire and changed and type(callback) == "function" then
            local ok, err = pcall(callback, value)
            if not ok then warn("[Aurora] Slider error: " .. tostring(err)) end
        end
        return value
    end
    Render()

    local draggingSlider = false
    local function FromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        SetValue(minValue + (maxValue - minValue) * rel, true)
    end
    window:Track(hitArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            FromX(input.Position.X)
        end
    end))
    window:Track(UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            FromX(input.Position.X)
        end
    end))
    window:Track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end))

    RegisterConfigurable(self, text, "Slider",
        function() return value end,
        function(v) SetValue(v, true) end)
    RegisterSearchItem(self, text, container)
    return { Set = function(v) SetValue(v, true) end, Get = function() return value end }
end

function TabMethods:AddDropdown(text, options, default, callback)
    local window = self.Window
    if not window or window.Destroyed then return nil end
    if type(default) == "function" then
        callback, default = default, nil
    end
    if type(options) ~= "table" then options = {} end

    local container = CreateElement(self.Container, NextOrder(self), ELEMENT_HEIGHT, window)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.ClipsDescendants = true
    Create("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = container,
    })

    local header = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, ELEMENT_HEIGHT),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = 1,
        Parent = container,
    })
    local label = Create("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -110, 1, 0),
        BackgroundTransparency = 1,
        Text = tostring(text or "Dropdown"),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = header,
    })
    BindTheme(window, label, "TextColor3", "Text")
    local valueLabel = Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -26, 0, 0),
        Size = UDim2.fromOffset(90, ELEMENT_HEIGHT),
        BackgroundTransparency = 1,
        Text = "...",
        TextColor3 = Theme.SubText,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = header,
    })
    local arrow = Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 0),
        Size = UDim2.fromOffset(14, ELEMENT_HEIGHT),
        BackgroundTransparency = 1,
        Text = "▾",
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Parent = header,
    })

    local listHolder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        LayoutOrder = 2,
        Parent = container,
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = listHolder,
    })
    Create("UIPadding", {
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6),
        Parent = listHolder,
    })

    local optionButtons = {}
    local selected = nil
    local function SetValue(value, fire)
        value = tostring(value)
        selected = value
        valueLabel.Text = selected
        for option, optionBtn in pairs(optionButtons) do
            Tween(optionBtn, TI_Fast, {
                BackgroundColor3 = option == selected and Theme.ElementBright or Theme.Element,
                TextColor3 = option == selected and Theme.Text or Theme.SubText,
            })
        end
        if fire and type(callback) == "function" then
            local ok, err = pcall(callback, selected)
            if not ok then warn("[Aurora] Dropdown error: " .. tostring(err)) end
        end
    end

    local expanded = false
    local function SetExpanded(open)
        expanded = open
        listHolder.Visible = open
        Tween(arrow, TI_Fast, { TextColor3 = open and Theme.Accent or Theme.SubText })
    end

    for _, rawOption in ipairs(options) do
        local option = tostring(rawOption)
        local optionBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 0.30,
            Text = option,
            TextColor3 = Theme.SubText,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            Parent = listHolder,
        })
        Corner(optionBtn, 6)
        Create("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = optionBtn })
        optionButtons[option] = optionBtn
        optionBtn.MouseButton1Click:Connect(function()
            SetValue(option, true)
            SetExpanded(false)
        end)
    end

    if default ~= nil then
        SetValue(default, false)
    end

    header.MouseButton1Click:Connect(function()
        SetExpanded(not expanded)
    end)

    RegisterConfigurable(self, text, "Dropdown",
        function() return selected end,
        function(value) SetValue(value, false) end)
    RegisterSearchItem(self, text, container)
    return { Set = function(value) SetValue(value, true) end, Get = function() return selected end }
end

function TabMethods:AddInput(text, placeholder, callback)
    local window = self.Window
    if not window or window.Destroyed then return nil end
    if type(placeholder) == "function" then
        callback, placeholder = placeholder, nil
    end

    local container = CreateElement(self.Container, NextOrder(self), 54, window)
    BindTheme(window, Create("TextLabel", {
        Position = UDim2.new(0, 10, 0, 7),
        Size = UDim2.new(1, -20, 0, 14),
        BackgroundTransparency = 1,
        Text = tostring(text or "Input"),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = container,
    }), "TextColor3", "Text")

    local box = Create("TextBox", {
        Position = UDim2.new(0, 10, 0, 26),
        Size = UDim2.new(1, -20, 0, 22),
        BackgroundColor3 = Theme.ElementPress,
        BackgroundTransparency = 0.20,
        Text = "",
        PlaceholderText = tostring(placeholder or ""),
        PlaceholderColor3 = Theme.SubText,
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        ClipsDescendants = true,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(box, 6)
    local boxStroke = Stroke(box)
    box.Focused:Connect(function()
        Tween(boxStroke, TI_Fast, { Color = Theme.Accent, Transparency = 0.30 })
    end)
    box.FocusLost:Connect(function(enterPressed)
        Tween(boxStroke, TI_Fast, { Color = Theme.Stroke, Transparency = 0.85 })
        if type(callback) == "function" and box.Text ~= "" then
            local ok, err = pcall(callback, box.Text)
            if not ok then warn("[Aurora] Input error: " .. tostring(err)) end
        end
    end)
    RegisterConfigurable(self, text, "Input",
        function() return box.Text end,
        function(value) box.Text = tostring(value or "") end)
    RegisterSearchItem(self, text, container)
    return box
end

TabMethods.AddTextbox = TabMethods.AddInput
TabMethods.AddTextBox = TabMethods.AddInput

--──────────────────────────── Destroy ═════════════════════════════════

function Aurora:Destroy()
    if self.Destroyed then return end
    self._destroying = true
    self.Destroyed = true

    if self._rgbThread then
        pcall(task.cancel, self._rgbThread)
        self._rgbThread = nil
    end
    for _, thread in ipairs(self.Threads) do
        pcall(coroutine.close, thread)
    end
    self.Threads = {}

    for _, fn in ipairs(self.Cleanups) do
        pcall(fn)
    end
    self.Cleanups = {}

    for _, connection in ipairs(self.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    self.Connections = {}

    for _, record in ipairs(self._activeNotifs) do
        pcall(function() record.Dismiss() end)
    end
    self._activeNotifs = {}

    self._themeBindings = {}
    self._themeUpdaters = {}

    pcall(function() self.GUI:Destroy() end)
end

