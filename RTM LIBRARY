function Aurora:AddTab(name, icon, pinned)
    if self.Destroyed then return nil end
    name = tostring(name or "Tab")
    self._tabCount += 1

    local tab = setmetatable({
        Window = self,
        Name = name,
        Icon = icon,
        SearchItems = {},
        _order = 0,
    }, TabMethods)

    local tabBtn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 0.35,
        Text = (icon and icon ~= "" and (icon .. "  ") or "") .. name,
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = pinned and 999999 or self._tabCount,
        Parent = self.TabContainer,
    })
    Corner(tabBtn, 8)
    Stroke(tabBtn)
    Create("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = tabBtn })
    BindTheme(self, tabBtn, "BackgroundColor3", "Element")

    local page = Create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.40,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.PageContainer,
    })
    BindTheme(self, page, "ScrollBarImageColor3", "Accent")
    Create("UIListLayout", {
        Padding = UDim.new(0, ELEMENT_GAP),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })
    -- ◄ FIX: page padding — elements sit inside the frame, never on its edge
    Create("UIPadding", {
        PaddingTop = UDim.new(0, PAGE_PADDING),
        PaddingBottom = UDim.new(0, PAGE_PADDING),
        PaddingLeft = UDim.new(0, PAGE_PADDING),
        PaddingRight = UDim.new(0, PAGE_PADDING),
        Parent = page,
    })

    tab.Button = tabBtn
    tab.Container = page

    local function SelectTab()
        if self.Destroyed or self.ActiveTab == tab then return end
        local previous = self.ActiveTab
        self.ActiveTab = tab
        if previous then
            if previous.Container then previous.Container.Visible = false end
            if previous.Button and previous.Button.Parent then
                Tween(previous.Button, TI_Fast, {
                    BackgroundColor3 = Theme.Element,
                    BackgroundTransparency = 0.35,
                    TextColor3 = Theme.SubText,
                })
            end
        end
        page.Visible = true
        Tween(tabBtn, TI_Fast, {
            BackgroundColor3 = Theme.ElementBright,
            BackgroundTransparency = 0.05,
            TextColor3 = Theme.Accent,
        })
        if self._applySearch then self._applySearch() end
    end
    tab.Select = SelectTab

    table.insert(self._themeUpdaters, function(accent)
        if self.ActiveTab == tab and tabBtn.Parent then
            Tween(tabBtn, TI_Fast, {
                TextColor3 = accent,
                BackgroundColor3 = Theme.ElementBright,
                BackgroundTransparency = 0.05,
            })
        end
    end)

    tabBtn.MouseButton1Click:Connect(SelectTab)
    table.insert(self.Tabs, tab)
    if not self.ActiveTab and (not pinned or #self.Tabs == 1) then
        SelectTab()
    end
    return tab
end

