function Aurora:Toggle()
    if self.Destroyed then return end
    if self.Root.Visible then
        self._hide(true)
    else
        self._show()
    end
end

function Aurora:OnClose(fn)
    if type(fn) == "function" and not self.Destroyed then
        table.insert(self.Cleanups, fn)
    end
end

function Aurora:Spawn(fn, ...)
    if self.Destroyed or type(fn) ~= "function" then return end
    local thread = coroutine.create(fn)
    table.insert(self.Threads, thread)
    local ok, err = coroutine.resume(thread, ...)
    if not ok then
        warn("[Aurora] Thread error: " .. tostring(err))
    end
    return thread
end

function Aurora:Track(connection)
    if connection and not self.Destroyed then
        table.insert(self.Connections, connection)
    end
    return connection
end

--──────────────── ◄ NEW: الثيمات الحية + الأكريليك ═══════════════════

function Aurora:SetTheme(name)
    if self.Destroyed then return false end
    local preset = Aurora.Themes[name]
    if not preset then return false end
    if self.CurrentTheme == name then return true end
    self.CurrentTheme = name

    for key, value in pairs(BaseTheme) do Theme[key] = value end
    for key, value in pairs(preset) do
        if key ~= "RGBMode" then Theme[key] = value end
    end
    Theme.AccentHover = Theme.Accent:Lerp(Color3.new(1, 1, 1), 0.18)
    Theme.AccentPress = Theme.Accent:Lerp(Color3.new(0, 0, 0), 0.35)

    -- تنظيف الروابط الميتة (إشعارات مُغلقة مثلاً)
    for index = #self._themeBindings, 1, -1 do
        if not self._themeBindings[index].Object.Parent then
            table.remove(self._themeBindings, index)
        end
    end

    for _, bind in ipairs(self._themeBindings) do
        pcall(Tween, bind.Object, TI_Smooth, { [bind.Property] = Theme[bind.Key] })
    end
    for _, updater in ipairs(self._themeUpdaters) do
        pcall(updater, Theme.Accent)
    end

    -- ثيم RGB: دوران لون التمييز عبر الطيف
    if preset.RGBMode and not self._rgbThread then
        local window = self
        self._rgbThread = task.spawn(function()
            local hue, last = 0, os.clock()
            while not window.Destroyed and window.CurrentTheme == "RGB" do
                local now = os.clock()
                hue = (hue + (now - last) * 0.12) % 1
                last = now
                local color = Color3.fromHSV(hue, 1, 1)
                Theme.Accent = color
                Theme.AccentHover = color:Lerp(Color3.new(1, 1, 1), 0.18)
                Theme.AccentPress = color:Lerp(Color3.new(0, 0, 0), 0.35)
                for _, bind in ipairs(window._themeBindings) do
                    if bind.Key == "Accent" and bind.Object.Parent then
                        pcall(function() bind.Object[bind.Property] = color end)
                    end
                end
                task.wait(1 / 30)
            end
            if window._rgbThread == coroutine.running() then
                window._rgbThread = nil
            end
        end)
    end
    return true
end

function Aurora:SetAcrylic(enabled)
    if self.Destroyed then return end
