-- مفتاح تبديل
function TabMethods:CreateToggle(name, default, callback)
    local container = CreateElement(self.Page, NextOrder(self), 38)
    CreateRowLabel(container, name, 72)

    local state = default == true

    local switch = Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(40, 22),
        BackgroundColor3 = state and Theme.Accent or Theme.ElementHover,
        BorderSizePixel = 0,
        Parent = container,
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = switch })
    local switchStroke = Stroke(switch, state and Theme.Accent or Theme.Stroke, state and 0.25 or 0.85, 1)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        Parent = switch,
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    -- الصف كامل قابل للضغط (تجربة لمس أفضل على الجوال)
    local hit = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
        Parent = container,
    })

    local function Render()
        if state then
            Tween(switch, TI_Fast, { BackgroundColor3 = Theme.Accent })
            Tween(switchStroke, TI_Fast, { Color = Theme.Accent, Transparency = 0.25 })
            Tween(knob, TI_Fast, { Position = UDim2.new(1, -19, 0.5, -8) })
        else
            Tween(switch, TI_Fast, { BackgroundColor3 = Theme.ElementHover })
            Tween(switchStroke, TI_Fast, { Color = Theme.Stroke, Transparency = 0.85 })
            Tween(knob, TI_Fast, { Position = UDim2.new(0, 3, 0.5, -8) })
        end
    end

    hit.MouseButton1Click:Connect(function()
        state = not state
        Render()
        if callback then
            local ok, err = pcall(callback, state)
            if not ok then warn("[Aurora] Toggle callback error: " .. tostring(err)) end
        end
    end)

    local handle = {}
    handle.Container = container
    handle.Set = function(value)
        value = value == true
        if value ~= state then
            state = value
            Render()
        end
    end
    handle.Get = function() return state end
    RegisterConfigurable(self, name, "Toggle", handle.Get, handle.Set)
    return handle
end

-- شريط تمرير
function TabMethods:CreateSlider(name, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    if max < min then
        min, max = max, min
    end
    default = math.clamp(tonumber(default) or min, min, max)

    local container = CreateElement(self.Page, NextOrder(self), 48)

    Create("TextLabel", {
        Size = UDim2.new(1, -114, 0, 16),
        Position = UDim2.new(0, 12, 0, 7),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = container,
    })

    local valueLabel = Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 7),
        Size = UDim2.fromOffset(86, 16),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Theme.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = container,
    })

    local track = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 5),
        Position = UDim2.new(0, 12, 1, -15),
        BackgroundColor3 = Theme.ElementHover,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(track, 3)

    local fill = Create("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    Corner(fill, 3)

    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = track,
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local useDecimals = (min % 1 ~= 0) or (max % 1 ~= 0) or (max - min) < 2
    local current = default

    local function SetValue(value, fire)
        current = math.clamp(value, min, max)
        local alpha = (current - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        if useDecimals then
            valueLabel.Text = tostring(math.round(current * 100) / 100)
        else
            valueLabel.Text = tostring(math.round(current))
        end
        if fire and callback then
            local ok, err = pcall(callback, current)
            if not ok then warn("[Aurora] Slider callback error: " .. tostring(err)) end
        end
    end
    SetValue(default, false)

    local hit = Create("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
        Parent = container,
    })

    local dragging = false
    local function UpdateFromX(xPosition)
        local rel = math.clamp(
            (xPosition - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        SetValue(min + (max - min) * rel, true)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            self.Page.ScrollingEnabled = false -- منع تمرير الصفحة أثناء السحب
            UpdateFromX(input.Position.X)
        end
    end)
    table.insert(self.Window.Connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromX(input.Position.X)
        end
    end))
    table.insert(self.Window.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                self.Page.ScrollingEnabled = true
            end
        end
    end))

    local handle = {}
    handle.Container = container
    handle.Set = function(value)
        SetValue(tonumber(value) or min, false)
    end
    handle.Get = function() return current end
    RegisterConfigurable(self, name, "Slider", handle.Get, handle.Set)
    return handle
end

