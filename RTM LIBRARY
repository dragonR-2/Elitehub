        Tween(dialog, TI_Smooth, { BackgroundTransparency = show and 0.10 or 1 })
        Tween(dialogStroke, TI_Smooth, { Transparency = show and 0.55 or 1 })
        Tween(dialogScale, TI_Smooth, { Scale = show and 1 or 0.88 })
        Tween(dialogContent, TI_Smooth, { GroupTransparency = show and 0 or 1 })
        if not show then
            task.delay(0.24, function()
                if not confirmOpen and not self.Destroyed then
                    overlay.Visible = false
                end
            end)
        end
    end

    -- إظهار / إخفاء النافذة (مع منع تضارب الحركات عبر Token)
    local hideToken = 0

    local function ShowWindow()
        if self.Destroyed then return end
        hideToken += 1
        -- مزامنة: إخفاء الزر العائم إن كان ظاهراً (عند الفتح بمفتاح التبديل)
        if self.FloatRoot.Visible then
            floatPulse:Cancel()
            self.FloatRoot.Visible = false
        end
        self.Root.Visible = true
        self.Content.GroupTransparency = 1
        rootScale.Scale = 0.92
        Tween(rootScale, TweenInfo.new(0.28, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), { Scale = 1 })
        Tween(self.Content, TI_Smooth, { GroupTransparency = 0 })
    end

    local function HideWindow(withFloating)
        if self.Destroyed then return end
        if confirmOpen then SetConfirm(false) end
        hideToken += 1
        local myToken = hideToken
        local tw = Tween(self.Content,
            TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { GroupTransparency = 1 })
        tw.Completed:Once(function()
            if self.Destroyed or myToken ~= hideToken then return end
            self.Root.Visible = false
            if withFloating then
                self.FloatRoot.Visible = true
                -- الحالة المخفية الابتدائية ثم ظهور ناعم للزر مع ظله
                self.FloatingBtn.BackgroundTransparency = 1
                self.FloatingBtn.TextTransparency = 1
                floatStroke.Transparency = 1
                floatScale.Scale = 0.60
                for _, shadow in ipairs(shadowLayers) do
                    shadow.Frame.BackgroundTransparency = 1
                end
                Tween(self.FloatingBtn, TI_Smooth, { BackgroundTransparency = 0.05, TextTransparency = 0 })
                Tween(floatScale, TI_Smooth, { Scale = 1 })
                Tween(floatStroke, TI_Smooth, { Transparency = 0.55 })
                FadeShadow(true)
                task.delay(0.25, function()
                    if self.FloatRoot.Visible and not self.Destroyed then
                        floatPulse:Play() -- بدء النبض المتوهج بعد اكتمال الظهور
                    end
                end)
            end
        end)
    end

    self._show = ShowWindow
    self._hide = HideWindow

    -- ربط الأزرار
    minBtn.MouseButton1Click:Connect(function()
        HideWindow(true)
    end)
    closeBtn.MouseButton1Click:Connect(function()
        SetConfirm(true)
    end)
    cancelBtn.MouseButton1Click:Connect(function()
        SetConfirm(false)
    end)
    exitBtn.MouseButton1Click:Connect(function()
        SetConfirm(false)
        task.delay(0.20, function()
            self:Destroy()
        end)
    end)
    overlay.MouseButton1Click:Connect(function()
        SetConfirm(false) -- الضغط خارج الصندوق يلغي
    end)

    -- سحب الزر العائم (السحب يحرك الحاوية مع الظل — مع تمييز النقر عن السحب)
    do
        local fDragging, fMoved = false, false
        local fStart, fOrigin

        self:Track(self.FloatingBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                fDragging, fMoved = true, false
                fStart = input.Position
                fOrigin = self.FloatRoot.Position
            end
        end))
        self:Track(UserInputService.InputChanged:Connect(function(input)
            if fDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - fStart
                if math.abs(delta.X) + math.abs(delta.Y) > 8 then
                    fMoved = true
                end
                self.FloatRoot.Position = UDim2.new(
                    fOrigin.X.Scale, fOrigin.X.Offset + delta.X,
                    fOrigin.Y.Scale, fOrigin.Y.Offset + delta.Y
                )
            end
        end))
        self:Track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                fDragging = false
            end
        end))

        self.FloatingBtn.MouseButton1Click:Connect(function()
            if fMoved then return end
            floatPulse:Cancel()
            Tween(self.FloatingBtn, TI_Fast, { BackgroundTransparency = 1, TextTransparency = 1 })
            Tween(floatStroke, TI_Fast, { Transparency = 1 })
            Tween(floatScale, TI_Fast, { Scale = 0.60 })
            FadeShadow(false)
            task.delay(0.12, function()
                if not self.Destroyed then
                    self.FloatRoot.Visible = false
                    ShowWindow()
                end
            end)
        end)
    end

    -- سحب النافذة من شريط العنوان (ماوس + لمس) — مع حماية من التعارض مع Resize
    local windowDragging, windowResizing = false, false
    do
        local dragStart, startPos
        self:Track(self.TitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                windowDragging = true
                dragStart = input.Position
                startPos = self.Root.Position
            end
        end))
        self:Track(UserInputService.InputChanged:Connect(function(input)
            if windowDragging and not windowResizing
            and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                self.Root.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end))
        self:Track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                windowDragging = false
            end
        end))
    end

    --════════════ منطق تغيير الحجم (ماوس + لمس) ════════════
    do
        local resizeStart, startSize, startPos

        self:Track(resizeGrip.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                windowResizing = true
                resizeStart = input.Position
                startSize = self.Root.AbsoluteSize
                startPos = self.Root.Position
                Tween(resizeGrip, TI_Fast, { TextTransparency = 0, TextColor3 = Theme.Accent })
            end
        end))

        self:Track(UserInputService.InputChanged:Connect(function(input)
            if windowResizing and not windowDragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - resizeStart
                -- سقف ذكي يمنع خروج النافذة عن حدود الشاشة (مهم جداً للجوال)
                local viewport = self.GUI.AbsoluteSize
                local maxW = math.max(MIN_SIZE.X, math.min(MAX_SIZE.X, viewport.X - 24))
                local maxH = math.max(MIN_SIZE.Y, math.min(MAX_SIZE.Y, viewport.Y - 24))
                -- math.clamp: حد أدنى وحد أقصى حتى لا تتشوه النافذة
                local newW = math.clamp(startSize.X + delta.X, MIN_SIZE.X, maxW)
                local newH = math.clamp(startSize.Y + delta.Y, MIN_SIZE.Y, maxH)
                self.Root.Size = UDim2.fromOffset(newW, newH)
                -- تثبيت الزاوية العلوية اليسرى أثناء التكبير/التصغير (سلوك النوافذ الحقيقي)
                self.Root.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + (newW - startSize.X) / 2,
                    startPos.Y.Scale, startPos.Y.Offset + (newH - startSize.Y) / 2
                )
            end
        end))

        self:Track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if windowResizing then
                    windowResizing = false
                    Tween(resizeGrip, TI_Fast, { TextTransparency = 0.45, TextColor3 = Theme.SubText })
                end
            end
        end))
    end

    -- مفتاح إظهار/إخفاء سريع
    self:Track(UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == self.Config.ToggleKey then
            if self.Root.Visible then
                HideWindow(true)
            else
                ShowWindow()
            end
        end
    end))

    -- ظهور أولي أنيق
    ShowWindow()

    return self
end

--──────────────────────────── وظائف النافذة ───────────────────────────

function Aurora:Toggle()
    if self.Destroyed then return end
    if self.Root.Visible then
        self._hide(true)
    else
        self._show()
    end
end

function Aurora:OnClose(fn)
    if type(fn) == "function" and not self.Destroyed then
        table.insert(self.Cleanups, fn)
    end
end

function Aurora:Spawn(fn, ...)
    if self.Destroyed or type(fn) ~= "function" then return end
    local thread = coroutine.create(fn)
    table.insert(self.Threads, thread)
    local ok, err = coroutine.resume(thread, ...)
    if not ok then
        warn("[Aurora] Thread error: " .. tostring(err))
    end
    return thread
end

function Aurora:Track(connection)
    if connection and not self.Destroyed then
        table.insert(self.Connections, connection)
    end
    return connection
end

--──────────────────── نظام الإشعارات التراكمية ────────────────────────
-- الاستخدام المتقدم:
--   Window:Notify({
--       Title = "عنوان", Message = "نص الرسالة", Duration = 5,
--       ButtonText = "Copy Link", ClipboardText = "https://...",
--       ButtonCallback = function() end,
--   })
-- أو بالشكل المختصر: Window:Notify("عنوان", "نص", 5)
function Aurora:Notify(options, legacyMessage, legacyDuration)
    if self.Destroyed then return nil end

    local title, message, duration
    local buttonText, buttonCallback, clipboardText

    if type(options) == "table" then
        title          = tostring(options.Title or "Notification")
        message        = tostring(options.Message or options.Text or "")
        duration       = tonumber(options.Duration) or 5
        buttonText     = options.ButtonText and tostring(options.ButtonText) or nil
        buttonCallback = (type(options.ButtonCallback) == "function") and options.ButtonCallback or nil
        clipboardText  = options.ClipboardText and tostring(options.ClipboardText) or nil
    else
        title    = tostring(options or "Notification")
        message  = tostring(legacyMessage or "")
        duration = tonumber(legacyDuration) or 5
    end
    duration = math.clamp(duration, 1, 60)

    -- سقف الإشعارات المتزامنة (4): الأقدم يُغلق فوراً عند الفيضان
    while #self._activeNotifs >= 4 do
        local oldest = table.remove(self._activeNotifs, 1)
        if oldest and oldest.Dismiss then
            pcall(oldest.Dismiss)
        end
    end

    self._notifOrder += 1

    local container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 0.10,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        LayoutOrder = self._notifOrder,
        Parent = self.NotifyHolder,
    })
    Corner(container, 10)
    Stroke(container)

    -- الطبقة المنزلقة (Slide In/Out) داخل حاوية مقصوصة
    local inner = Create("CanvasGroup", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        Position = UDim2.new(0, 320, 0, 0), -- يبدأ خارج الحاوية (يمين)
        Parent = container,
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = inner,
    })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        Parent = inner,
    })

    local dismissed = false
    local Dismiss
    local progressTween

    -- صف العنوان (نقطة تمييز + نص + زر إغلاق)
    local titleRow = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = 1,
        Parent = inner,
    })
    local notifDot = Create("Frame", {
        Size = UDim2.fromOffset(6, 6),
        Position = UDim2.new(0, 0, 0.5, -3),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = titleRow,
    })
    Corner(notifDot, 3)
    Create("TextLabel", {
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = titleRow,
    })
    local closeBtn = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundTransparency = 1,
        Text = "✕",
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = titleRow,
    })
    closeBtn.MouseButton1Click:Connect(function()
        Dismiss()
    end)

    -- نص الرسالة (اختياري — يتمدد تلقائياً حسب الطول)
    local nextOrder = 2
    if message ~= "" then
        Create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text = message,
            TextColor3 = Theme.SubText,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            Parent = inner,
        })
        nextOrder = 3
    end

    -- زر تفاعلي اختياري (مثال: نسخ رابط إلى الحافظة بضغطة واحدة)
    if buttonText then
        local actionBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = Theme.Accent,
            Text = buttonText,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = nextOrder,
            Parent = inner,
        })
        Corner(actionBtn, 6)
        Stroke(actionBtn)
        BindHover(actionBtn, Theme.Accent, Theme.AccentHover, Theme.AccentPress)
        actionBtn.MouseButton1Click:Connect(function()
            if clipboardText then
                CopyToClipboard(clipboardText)
                actionBtn.Text = "Copied ✓" -- تأكيد بصري فوري
                task.delay(1.1, function()
                    if actionBtn.Parent then
                        actionBtn.Text = buttonText
                    end
                end)
            end
            if buttonCallback then
                local ok, err = pcall(buttonCallback)
                if not ok then warn("[Aurora] Notify button error: " .. tostring(err)) end
            end
            task.delay(clipboardText and 1.1 or 0.15, function()
                Dismiss()
            end)
        end)
    end

    -- شريط عمر الإشعار (يستنزف تدريجياً بمرور الوقت)
    local progressTrack = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Theme.ElementHover,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        LayoutOrder = 50,
        Parent = inner,
    })
    Corner(progressTrack, 1)
    local progressFill = Create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = progressTrack,
    })
    Corner(progressFill, 1)

    -- تسجيل الإشعار ضمن القائمة النشطة
    local record = { Container = container }
    table.insert(self._activeNotifs, record)

    Dismiss = function()
        if dismissed then return end
        dismissed = true
        for index, item in ipairs(self._activeNotifs) do
            if item == record then
                table.remove(self._activeNotifs, index)
                break
            end
        end
        if progressTween then
            pcall(function() progressTween:Cancel() end)
        end
        if self.Destroyed or not container.Parent then
            pcall(function() container:Destroy() end)
            return
        end
        -- خروج انسيابي: انزلاق خارج + تلاشي
        local slideOut = Tween(inner,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {
                Position = UDim2.new(0, math.max(container.AbsoluteSize.X, 220) + 30, 0, 0),
                GroupTransparency = 1,
            })
        slideOut.Completed:Once(function()
            pcall(function() container:Destroy() end)
        end)
    end
    record.Dismiss = Dismiss

    -- دخول انسيابي: انزلاق + تلاشي
    Tween(inner, TweenInfo.new(0.30, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
        GroupTransparency = 0,
    })

    -- استنزاف شريط العمر + إغلاق تلقائي بعد المدة
    progressTween = Tween(progressFill,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, 0, 1, 0) })
    task.delay(duration, function()
        Dismiss()
    end)

    return record -- يحتوي .Dismiss لإغلاقه برمجياً عند الحاجة
end

--──────────────────── مقاس النافذة (للحفظ والاسترجاع) ─────────────────

-- قراءة مقاس النافذة الحالي بالبكسل (يشمل تعديلات Resize Grip)
function Aurora:GetWindowSize()
    local size = self.Root.AbsoluteSize
    return math.round(size.X), math.round(size.Y)
end

-- تعيين مقاس النافذة يدوياً بحدود آمنة (يُستخدم داخلياً في LoadConfig)
function Aurora:SetWindowSize(width, height)
    if self.Destroyed then return false end
    width  = tonumber(width)
    height = tonumber(height)
    if not width or not height then return false end

    local minSize  = self._minSize
    local maxSize  = self._maxSize
    local viewport = self.GUI.AbsoluteSize

    -- سقف ذكي حسب الشاشة (مهم للجوال) + math.clamp للحدود
    local maxW = math.max(minSize.X, math.min(maxSize.X, viewport.X - 24))
    local maxH = math.max(minSize.Y, math.min(maxSize.Y, viewport.Y - 24))
    local newW = math.clamp(math.floor(width), minSize.X, maxW)
    local newH = math.clamp(math.floor(height), minSize.Y, maxH)

    local oldSize = self.Root.AbsoluteSize
    local oldPos  = self.Root.Position
    self.Root.Size = UDim2.fromOffset(newW, newH)
    -- تعويض حول المركز حتى لا "تقفز" النافذة
    self.Root.Position = UDim2.new(
        oldPos.X.Scale, oldPos.X.Offset + (newW - oldSize.X) / 2,
        oldPos.Y.Scale, oldPos.Y.Offset + (newH - oldSize.Y) / 2
    )
    return true
end

--────────────────────── نظام حفظ وتحميل الإعدادات ─────────────────────

-- حفظ كل الإعدادات + مقاس النافذة في ملف JSON
-- الاستخدام: Window:SaveConfig("MyHub", "config")
function Aurora:SaveConfig(folderName, fileName)
    if self.Destroyed then return false, "Window is destroyed" end
    if type(writefile) ~= "function" or type(readfile) ~= "function" then
        return false, "This executor does not support the file system"
    end

    folderName = tostring(folderName or "AuroraUI")
    fileName   = tostring(fileName or "config")

    local data = { WindowSize = {}, Elements = {} }

    -- [حاسم] حفظ مقاس النافذة الحالي (الذي عدّله المستخدم عبر Resize Grip)
    local okSize, w, h = pcall(function()
        return self:GetWindowSize()
    end)
    if okSize and w and h and w > 50 and h > 50 then
        data.WindowSize = { W = w, H = h }
    end

    -- حفظ حالة كل عنصر تفاعلي مسجل في الـ Registry
    for key, entry in pairs(self.Registry) do
        local okGet, value = pcall(entry.Get)
        if okGet and value ~= nil then
            if typeof(value) == "Color3" then
                value = { R = value.R, G = value.G, B = value.B } -- Color3 لا يُشفَّر مباشرة
            end
            data.Elements[key] = { T = entry.Type, V = value }
        end
    end

    local okEncode, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not okEncode or type(encoded) ~= "string" then
        return false, "JSON encoding failed"
    end

    -- تجهيز المجلد بأمان (makefolder / isfolder)
    if type(isfolder) == "function" and type(makefolder) == "function" then
        local exists = false
        pcall(function() exists = (isfolder(folderName) == true) end)
        if not exists then
            local okMake = pcall(makefolder, folderName)
            if not okMake then
                return false, "Could not create folder: " .. folderName
            end
        end
    end

    local path = folderName .. "/" .. fileName .. ".json"
    local okWrite = pcall(writefile, path, encoded)
    if not okWrite then
        return false, "Could not write: " .. path
    end
    return true, path
end

-- استرجاع الإعدادات + مقاس النافذة من ملف JSON
-- الاستخدام: Window:LoadConfig("MyHub", "config")
function Aurora:LoadConfig(folderName, fileName)
    if self.Destroyed then return false, "Window is destroyed" end
    if type(readfile) ~= "function" then
        return false, "This executor does not support the file system"
    end

    folderName = tostring(folderName or "AuroraUI")
    fileName   = tostring(fileName or "config")
    local path = folderName .. "/" .. fileName .. ".json"

    local okRead, raw = pcall(readfile, path)
    if not okRead or type(raw) ~= "string" or raw == "" then
        return false, "Config file not found: " .. path
    end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not okDecode or type(data) ~= "table" then
        return false, "Config file is corrupted"
    end

    -- [حاسم] استرجاع المقاس المخصص أولاً (من Resize Grip)
    if type(data.WindowSize) == "table"
    and tonumber(data.WindowSize.W) and tonumber(data.WindowSize.H) then
        self:SetWindowSize(data.WindowSize.W, data.WindowSize.H)
    end

    -- استرجاع حالة كل عنصر مسجل (تطبيق صامت — لا يطلق الـ Callbacks)
    local applied = 0
    for key, saved in pairs(data.Elements or {}) do
        local entry = self.Registry[key]
        if entry and type(saved) == "table" then
            local value = saved.V
            -- إعادة تحويل Color3 المخزن كجدول {R, G, B}
            if entry.Type == "Colorpicker" and type(value) == "table"
            and tonumber(value.R) and tonumber(value.G) and tonumber(value.B) then
                value = Color3.new(value.R, value.G, value.B)
            end
            if pcall(entry.Set, value) then
                applied += 1
            end
        end
    end

    return true, applied
end

function Aurora:Destroy()
    if self.Destroyed or self._destroying then return end
    self._destroying = true

    -- تشغيل دوال التنظيف أولاً (يتيح للمستخدم حفظ الإعدادات عند الخروج)
    for _, fn in ipairs(self.Cleanups) do
        pcall(fn)
    end
    table.clear(self.Cleanups)

    self.Destroyed = true

    for _, thread in ipairs(self.Threads) do
        pcall(task.cancel, thread)
    end
    table.clear(self.Threads)

    for _, connection in ipairs(self.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(self.Connections)

    pcall(function() self.GUI:Destroy() end)
end

