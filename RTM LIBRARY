-- منتقي ألوان
function TabMethods:CreateColorpicker(name, defaultColor, callback)
    local color = typeof(defaultColor) == "Color3" and defaultColor or Color3.fromRGB(255, 255, 255)

    local collapsed = 38
    local container = CreateElement(self.Page, NextOrder(self), collapsed)
    container.ClipsDescendants = true
    CreateRowLabel(container, name, 74)

    local swatch = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(42, 24),
        BackgroundColor3 = color,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(swatch, 8)
    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.55, Parent = swatch })

    local palette = {
        Color3.fromRGB(255, 255, 255), Color3.fromRGB(178, 178, 190), Color3.fromRGB(96, 96, 108),  Color3.fromRGB(25, 25, 32),
        Color3.fromRGB(235, 75, 75),   Color3.fromRGB(240, 150, 60),  Color3.fromRGB(240, 220, 80), Color3.fromRGB(95, 215, 125),
        Color3.fromRGB(80, 205, 215),  Color3.fromRGB(0, 140, 255),   Color3.fromRGB(138, 43, 226), Color3.fromRGB(235, 100, 190),
    }
    local rows = math.ceil(#palette / 6)
    local gridHeight = rows * 24 + (rows - 1) * 6 + 12

    local paletteFrame = Create("Frame", {
        Position = UDim2.new(0, 10, 0, collapsed + 2),
        Size = UDim2.new(1, -20, 0, 0),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Visible = false,
        Parent = container,
    })
    Corner(paletteFrame, 8)
    Create("UIGridLayout", { -- خلايا مرنة تتكيف مع عرض الشاشة
        CellSize = UDim2.new(1 / 6, -7, 0, 24),
        CellPadding = UDim2.new(0, 6, 0, 6),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = paletteFrame,
    })
    Create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = paletteFrame })

    local open = false
    local function SetOpen(value)
        if open == value then return end
        open = value
        if value then
            paletteFrame.Visible = true
            Tween(container, TI_Smooth, { Size = UDim2.new(1, 0, 0, collapsed + 4 + gridHeight) })
            Tween(paletteFrame, TI_Smooth, { Size = UDim2.new(1, -20, 0, gridHeight) })
        else
            Tween(container, TI_Fast, { Size = UDim2.new(1, 0, 0, collapsed) })
            local tw = Tween(paletteFrame, TI_Fast, { Size = UDim2.new(1, -20, 0, 0) })
            tw.Completed:Once(function()
                if not open then
                    paletteFrame.Visible = false
                end
            end)
        end
    end

    for index, cellColor in ipairs(palette) do
        local cellBtn = Create("TextButton", {
            BackgroundColor3 = cellColor,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = index,
            Parent = paletteFrame,
        })
        Corner(cellBtn, 6)
        Stroke(cellBtn)
        cellBtn.MouseButton1Click:Connect(function()
            color = cellColor
            swatch.BackgroundColor3 = color
            SetOpen(false)
            if callback then
                local ok, err = pcall(callback, color)
                if not ok then warn("[Aurora] Colorpicker callback error: " .. tostring(err)) end
            end
        end)
    end

    swatch.MouseButton1Click:Connect(function()
        SetOpen(not open)
    end)

    local handle = {}
    handle.Container = container
    handle.Set = function(value)
        if typeof(value) == "Color3" then
            color = value
            swatch.BackgroundColor3 = color
        end
    end
    handle.Get = function() return color end
    RegisterConfigurable(self, name, "Colorpicker", handle.Get, handle.Set)
    return handle
end

