-- ربط مفتاح اختصار (وضع التقاط بتوهج بنفسجي)
function TabMethods:CreateKeybind(name, defaultKey, callback)
    local container = CreateElement(self.Page, NextOrder(self), 40)
    CreateRowLabel(container, name, 102)
    RegisterSearchItem(self, name, container)

    local currentKey = defaultKey
    local listening = false

    local bindBtn = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(74, 28),
        BackgroundColor3 = Theme.ElementHover,
        Text = currentKey and currentKey.Name or "None",
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(bindBtn, 10)
    local bindStroke = Stroke(bindBtn, Theme.Stroke, 0.90, 1)

    local function SetListening(on)
        listening = on
        if on then
            bindBtn.Text = "..."
            Tween(bindBtn, TI_Fast, { BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text })
            Tween(bindStroke, TI_Fast, { Color = Theme.Accent, Transparency = 0.25 })
        else
            bindBtn.Text = currentKey and currentKey.Name or "None"
            Tween(bindBtn, TI_Fast, { BackgroundColor3 = Theme.ElementHover, TextColor3 = Theme.SubText })
            Tween(bindStroke, TI_Fast, { Color = Theme.Stroke, Transparency = 0.90 })
        end
    end

    bindBtn.MouseButton1Click:Connect(function()
        SetListening(true)
    end)

    table.insert(self.Window.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                SetListening(false)
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                SetListening(false) -- نقرة أخرى تلغي وضع الالتقاط
            end
            return
        end

        if not processed and currentKey and input.KeyCode == currentKey then
            if callback then
                local ok, err = pcall(callback)
                if not ok then warn("[RTM] Keybind callback error: " .. tostring(err)) end
            end
        end
    end))

    local handle = {}
    handle.Container = container
    handle.Set = function(key)
        currentKey = key
        if not listening then
            bindBtn.Text = currentKey and currentKey.Name or "None"
        end
    end
    handle.Get = function() return currentKey end
    RegisterConfigurable(self, name, "Keybind",
        function() return currentKey and currentKey.Name or "" end,
        function(value)
            if type(value) == "string" and value ~= "" then
                local ok, key = pcall(function() return Enum.KeyCode[value] end)
                if ok and key then
                    handle.Set(key)
                end
            end
        end)
    return handle
end

