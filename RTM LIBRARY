    BindHover(btn, Theme.Accent, Theme.AccentHover, Theme.AccentPress)

    if assetId then -- أيقونة تُعرض بجانب النص بتنسيق متناسق
        btn.Text = "💎"
        Create("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5),
