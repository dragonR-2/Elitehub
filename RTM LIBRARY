-- ==========================================
-- Aurora UI Library (Fixed & Optimized)
-- ==========================================

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local Theme = {
    Background = Color3.fromRGB(15, 15, 20),
    Glass = Color3.fromRGB(25, 25, 35),
    Stroke = Color3.fromRGB(45, 45, 60),
    Accent = Color3.fromRGB(0, 255, 255),
    Text = Color3.fromRGB(255, 255, 255),
    SubText = Color3.fromRGB(160, 160, 180),
    Danger = Color3.fromRGB(255, 60, 60)
}

local function Create(instance, props)
    local obj = Instance.new(instance)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local uiParent = gethui and gethui() or CoreGui
if not uiParent then uiParent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end

-- ==========================================
-- 1. كلاس النافذة الرئيسية (Window)
-- ==========================================
local Aurora = {}
Aurora.__index = Aurora

function Aurora.new(config)
    local self = setmetatable({}, Aurora)
    self.Connections = {}
    
    self.GUI = Create("ScreenGui", { Name = "Aurora_" .. math.random(1000,9999), Parent = uiParent, ResetOnSpawn = false, DisplayOrder = 9999 })
    
    -- الزر العائم (💎)
    self.FloatingBtn = Create("TextButton", {
        Name = "FloatingToggle", Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(0, 20, 0.5, -22),
        BackgroundColor3 = Theme.Glass, BackgroundTransparency = 1, Text = "💎", TextSize = 20,
        TextTransparency = 1, Active = true, Visible = false, Parent = self.GUI
    })
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = self.FloatingBtn })
    local floatStroke = Create("UIStroke", { Color = Theme.Accent, Thickness = 2, Transparency = 1, Parent = self.FloatingBtn })
    
    -- النافذة الرئيسية
    self.MainFrame = Create("Frame", {
        Name = "MainFrame", Size = UDim2.new(0, 500, 0, 350), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.1, Parent = self.GUI
    })
    Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = self.MainFrame })
    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1.5, Transparency = 0.5, Parent = self.MainFrame })
    
    self.UIContent = Create("CanvasGroup", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, GroupTransparency = 0, Parent = self.MainFrame })
    
    -- شريط العنوان
    self.TitleBar = Create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Glass, Parent = self.UIContent })
    Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = self.TitleBar })
    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1, Parent = self.TitleBar })
    Create("TextLabel", {
        Size = UDim2.new(1, -100, 1, 0), Position = UDim2.new(0, 15, 0, 0), BackgroundTransparency = 1,
        Text = config.Title or "Aurora UI", TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold,
        TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = self.TitleBar
    })
    
    local MinBtn = Create("TextButton", {Size = UDim2.new(0, 25, 0, 25), Position = UDim2.new(1, -65, 0.5, -12), BackgroundColor3 = Theme.Stroke, Text = "-", TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 16, Parent = self.TitleBar})
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = MinBtn })
    local CloseBtn = Create("TextButton", {Size = UDim2.new(0, 25, 0, 25), Position = UDim2.new(1, -30, 0.5, -12), BackgroundColor3 = Theme.Danger, Text = "X", TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 12, Parent = self.TitleBar})
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = CloseBtn })
    
    -- التبويبات
    self.TabContainer = Create("Frame", {Size = UDim2.new(0, 130, 1, -40), Position = UDim2.new(0, 0, 0, 40), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.5, Parent = self.UIContent})
    Create("UIListLayout", { Padding = UDim.new(0, 5), Parent = self.TabContainer })
    Create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), Parent = self.TabContainer })
    
    self.ContentContainer = Create("Frame", {Size = UDim2.new(1, -140, 1, -50), Position = UDim2.new(0, 140, 0, 45), BackgroundColor3 = Theme.Glass, BackgroundTransparency = 0.5, Parent = self.UIContent})
    Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = self.ContentContainer })
    
    -- سحب النافذة
    local dragging, dragInput, dragStart, startPos
    table.insert(self.Connections, self.TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = self.MainFrame.Position
        end
    end))
    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end))
    
    -- سحب الزر العائم
    local fDragging, fDragInput, fDragStart, fStartPos, fMoved
    table.insert(self.Connections, self.FloatingBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            fDragging = true; fDragStart = input.Position; fStartPos = self.FloatingBtn.Position; fMoved = false
        end
    end))
    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then fDragInput = input end
        if input == fDragInput and fDragging then
            local delta = input.Position - fDragStart
            if delta.Magnitude > 5 then fMoved = true end
            self.FloatingBtn.Position = UDim2.new(fStartPos.X.Scale, fStartPos.X.Offset + delta.X, fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y)
        end
    end))
    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then fDragging = false end
    end))
    
    -- أنيميشن الإخفاء
    MinBtn.MouseButton1Click:Connect(function()
        local fadeOut = TweenService:Create(self.UIContent, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1})
        fadeOut:Play()
        fadeOut.Completed:Connect(function()
            self.MainFrame.Visible = false
            self.FloatingBtn.Visible = true
            TweenService:Create(self.FloatingBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
            TweenService:Create(floatStroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
        end)
    end)
    
    self.FloatingBtn.MouseButton1Click:Connect(function()
        if fMoved then return end
        TweenService:Create(self.FloatingBtn, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        TweenService:Create(floatStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
        task.wait(0.2)
        self.FloatingBtn.Visible = false
        self.MainFrame.Visible = true
        TweenService:Create(self.UIContent, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
    end)
    
    -- زر الإغلاق
    CloseBtn.MouseButton1Click:Connect(function()
        for _, conn in ipairs(self.Connections) do pcall(function() conn:Disconnect() end) end
        self.GUI:Destroy()
    end)
    
    self.Tabs = {}
    return self
end

function Aurora:CreateTab(name)
    local Tab = {}
    Tab.Name = name
    Tab.Window = self
    Tab.Connections = self.Connections
    
    Tab.Button = Create("TextButton", {Size = UDim2.new(1, -10, 0, 30), BackgroundColor3 = Theme.Glass, BackgroundTransparency = 0.5, Text = "  " .. name, TextColor3 = Theme.SubText, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = self.TabContainer})
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Tab.Button })
    
    -- إصلاح التمرير (Scrolling Fix)
    Tab.Page = Create("ScrollingFrame", {
        Size = UDim2.new(1, -20, 1, -20), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1,
        ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent, Visible = false, Parent = self.ContentContainer,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0) -- تمدد تلقائي
    })
    Create("UIListLayout", { Padding = UDim.new(0, 8), Parent = Tab.Page })
    
    Tab.Button.MouseButton1Click:Connect(function()
        for _, t in pairs(self.Tabs) do
            t.Page.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Glass, TextColor3 = Theme.SubText}):Play()
        end
        Tab.Page.Visible = true
        TweenService:Create(Tab.Button, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Background}):Play()
    end)
    
    table.insert(self.Tabs, Tab)
    if #self.Tabs == 1 then
        Tab.Page.Visible = true
        TweenService:Create(Tab.Button, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Background}):Play()
    end
    
    setmetatable(Tab, { __index = function(t, k) return Aurora.TabMethods[k] end })
    return Tab
end

-- ==========================================
-- 2. محرك العناصر (Fixed Elements Engine)
-- ==========================================
Aurora.TabMethods = {}

local function CreateBaseContainer(parent, name, height)
    local Container = Create("Frame", {Size = UDim2.new(1, -10, 0, height or 40), BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.5, Parent = parent})
    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Container })
    Create("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.5, Parent = Container })
    if name then
        Create("TextLabel", {Size = UDim2.new(0.5, 0, 0, 20), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1, Text = name, TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = Container})
    end
    return Container
end

-- 1. CreateButton
function Aurora.TabMethods:CreateButton(name, callback)
    local Container = CreateBaseContainer(self.Page, name, 35)
    local Btn = Create("TextButton", {Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -70, 0.5, -10), BackgroundColor3 = Theme.Accent, Text = "Run", TextColor3 = Theme.Background, Font = Enum.Font.GothamBold, TextSize = 11, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Btn })
    Btn.MouseButton1Click:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 55, 0, 18)}):Play()
        task.wait(0.1); TweenService:Create(Btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 60, 0, 20)}):Play()
        if callback then callback() end
    end)
end

-- 2. CreateToggle
function Aurora.TabMethods:CreateToggle(name, default, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local State = default or false
    local Switch = Create("TextButton", {Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = State and Theme.Accent or Theme.Stroke, Text = "", Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Switch })
    local Knob = Create("Frame", {Size = UDim2.new(0, 16, 0, 16), Position = State and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Theme.Text, Parent = Switch})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })
    
    Switch.MouseButton1Click:Connect(function()
        State = not State
        if State then
            TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            TweenService:Create(Switch, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Stroke}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
        if callback then callback(State) end
    end)
end

-- 3. CreateSlider (تم الإصلاح: منع تسريب الذاكرة + توسيع اللمس)
function Aurora.TabMethods:CreateSlider(name, min, max, default, callback)
    local Container = CreateBaseContainer(self.Page, name, 50)
    -- شريط الشفافية الخلفي (Hitbox) لتوسيع مساحة اللمس على الهواتف
    local Hitbox = Create("TextButton", {
        Size = UDim2.new(1, -10, 1, 0), BackgroundTransparency = 1, Text = "", Parent = Container
    })
    
    local Track = Create("Frame", {Size = UDim2.new(1, -20, 0, 4), Position = UDim2.new(0, 10, 0, 35), BackgroundColor3 = Theme.Stroke, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })
    local Fill = Create("Frame", {Size = UDim2.new((default-min)/(max-min), 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = Track})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Fill })
    local Knob = Create("Frame", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -6, 0.5, -4), BackgroundColor3 = Theme.Text, Parent = Fill})
    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })
    
    local dragging = false
    local function updateSlider(input)
        local pos = input.Position.X - Track.AbsolutePosition.X
        local percent = math.clamp(pos / Track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * percent)
        Fill.Size = UDim2.new(percent, 0, 1, 0)
        if callback then callback(value) end
    end
    
    -- بدء السحب من الحاوية كاملة (Hitbox)
    Hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    
    -- إصلاح تسريب الذاكرة: إضافة Connections إلى self.Connections
    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    
    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end))
end

-- 4. CreateDropdown (تم الإصلاح: تمدد الحاوية عند الفتح)
function Aurora.TabMethods:CreateDropdown(name, options, default, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local Selected = default or options[1]
    local Btn = Create("TextButton", {Size = UDim2.new(0, 100, 0, 20), Position = UDim2.new(1, -110, 0.5, -10), BackgroundColor3 = Theme.Glass, Text = Selected, TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 11, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Btn })
    
    local isOpen = false
    local listHeight = #options * 22 + 10
    local listFrame = Create("Frame", {Size = UDim2.new(1, -10, 0, listHeight), Position = UDim2.new(0, 5, 0, 40), BackgroundColor3 = Theme.Background, Visible = false, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = listFrame })
    Create("UIListLayout", { Padding = UDim.new(0, 2), Parent = listFrame })
    
    for _, opt in ipairs(options) do
        local optBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = Theme.Glass, Text = opt, TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 11, Parent = listFrame})
        optBtn.MouseButton1Click:Connect(function()
            Selected = opt; Btn.Text = Selected
            if callback then callback(Selected) end
            isOpen = false
            listFrame.Visible = false
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
        end)
    end
    
    Btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        listFrame.Visible = isOpen
        if isOpen then
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40 + listHeight)}):Play()
        else
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
        end
    end)
end

-- 5. CreateInput
function Aurora.TabMethods:CreateInput(name, placeholder, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local Box = Create("TextBox", {Size = UDim2.new(0, 100, 0, 20), Position = UDim2.new(1, -110, 0.5, -10), BackgroundColor3 = Theme.Glass, Text = "", PlaceholderText = placeholder or "Enter...", TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 11, ClearTextOnFocus = false, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Box })
    Box.FocusLost:Connect(function(enterPressed)
        if callback then callback(Box.Text, enterPressed) end
    end)
end

-- 6. CreateKeybind
function Aurora.TabMethods:CreateKeybind(name, defaultKey, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local currentKey = defaultKey
    local Btn = Create("TextButton", {Size = UDim2.new(0, 60, 0, 20), Position = UDim2.new(1, -70, 0.5, -10), BackgroundColor3 = Theme.Glass, Text = tostring(currentKey.Name), TextColor3 = Theme.Text, Font = Enum.Font.GothamSemibold, TextSize = 11, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Btn })
    
    local listening = false
    Btn.MouseButton1Click:Connect(function()
        listening = true; Btn.Text = "..."
    end)
    
    table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            listening = false; currentKey = input.KeyCode; Btn.Text = tostring(currentKey.Name)
        elseif input.KeyCode == currentKey and not processed then
            if callback then callback() end
        end
    end))
end

-- 7. CreateColorpicker (تم الإصلاح: تمدد الحاوية عند الفتح)
function Aurora.TabMethods:CreateColorpicker(name, defaultColor, callback)
    local Container = CreateBaseContainer(self.Page, name, 40)
    local color = defaultColor or Color3.fromRGB(255,255,255)
    local Swatch = Create("TextButton", {Size = UDim2.new(0, 30, 0, 20), Position = UDim2.new(1, -40, 0.5, -10), BackgroundColor3 = color, Text = "", Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = Swatch })
    
    local palette = {Color3.fromRGB(255,0,0), Color3.fromRGB(0,255,0), Color3.fromRGB(0,0,255), Color3.fromRGB(255,255,0), Color3.fromRGB(0,255,255), Color3.fromRGB(255,255,255)}
    local isOpen = false
    local paletteHeight = 60
    local listFrame = Create("Frame", {Size = UDim2.new(0, 120, 0, paletteHeight), Position = UDim2.new(1, -130, 0, 40), BackgroundColor3 = Theme.Background, Visible = false, Parent = Container})
    Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = listFrame })
    Create("UIGridLayout", {CellSize = UDim2.new(0, 25, 0, 25), CellPadding = UDim2.new(0, 5, 0, 5), Parent = listFrame})
    
    for _, c in ipairs(palette) do
        local b = Create("TextButton", {BackgroundColor3 = c, Text = "", Parent = listFrame})
        Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = b })
        b.MouseButton1Click:Connect(function()
            color = c; Swatch.BackgroundColor3 = c
            if callback then callback(c) end
            isOpen = false; listFrame.Visible = false
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
        end)
    end
    
    Swatch.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        listFrame.Visible = isOpen
        if isOpen then
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40 + paletteHeight)}):Play()
        else
            TweenService:Create(Container, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 40)}):Play()
        end
    end)
end

