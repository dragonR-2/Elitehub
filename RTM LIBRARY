function Aurora:SetBackgroundImage(asset, transparency, options)
    if self.Destroyed or not self.BackgroundImage then return false end
    options = type(options) == "table" and options or {}

    local id = ToAssetId(asset)
    if not id then
        self._bgAsset = nil
        Tween(self.BackgroundImage, TI_Smooth, { ImageTransparency = 1 })
        for _, layer in ipairs(self._frostLayers) do
            Tween(layer, TI_Smooth, { ImageTransparency = 1 })
        end
        task.delay(0.25, function()
            if not self.Destroyed and self.BackgroundOverlay then
                self.BackgroundOverlay.Visible = false
            end
        end)
        return false
    end

    self._bgAsset = id
    self._bgTransparency = tonumber(transparency) or self._bgTransparency or 0
    self.BackgroundImage.Image = id
    self.BackgroundOverlay.Visible = true
    Tween(self.BackgroundImage, TI_Smooth, { ImageTransparency = self._bgTransparency })
    for index, layer in ipairs(self._frostLayers) do
        layer.Image = id
        if self._frostEnabled then
            layer.Visible = true
            Tween(layer, TI_Smooth, { ImageTransparency = math.min(self._bgTransparency + 0.15 * index, 0.95) })
        end
    end
    if options.Overlay ~= nil then self:SetBackgroundOverlay(options.Overlay) end
    if options.Frost ~= nil then self:SetBackgroundFrost(options.Frost) end
    return true
end

function Aurora:ClearBackgroundImage()
    return self:SetBackgroundImage(nil)
end

function Aurora:SetWallpaperTransparency(transparency)
    if self.Destroyed then return false end
    transparency = math.clamp(tonumber(transparency) or 0, 0, 1)
    self._bgTransparency = transparency
    Tween(self.BackgroundImage, TI_Fast, { ImageTransparency = transparency })
    if self._frostEnabled then
        for index, layer in ipairs(self._frostLayers) do
            Tween(layer, TI_Fast, { ImageTransparency = math.min(transparency + 0.15 * index, 0.95) })
        end
    end
    return true
end

function Aurora:SetBackgroundOverlay(opacity)
    if self.Destroyed or not self.BackgroundOverlay then return false end
    opacity = tonumber(opacity)
    if not opacity then return false end
    opacity = math.clamp(opacity, 0, 1)
    self.BackgroundOverlay.Visible = self.BackgroundImage.Image ~= ""
    Tween(self.BackgroundOverlay, TI_Smooth, { BackgroundTransparency = 1 - opacity })
    return true
end

function Aurora:SetBackgroundFrost(enabled)
    if self.Destroyed then return false end
    self._frostEnabled = enabled and true or false
    local base = self._bgTransparency or 0
    for index, layer in ipairs(self._frostLayers) do
        if self._frostEnabled and self.BackgroundImage.Image ~= "" then
            layer.Visible = true
            Tween(layer, TI_Smooth, { ImageTransparency = math.min(base + 0.15 * index, 0.95) })
        else
            Tween(layer, TI_Smooth, { ImageTransparency = 1 })
            task.delay(0.24, function()
                if not self._frostEnabled and layer.Parent then
                    layer.Visible = false
                end
            end)
        end
    end
    return true
end

