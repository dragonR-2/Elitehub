    TitleBar.Size = UDim2.new(1, 0, 0, 40)
    TitleBar.BackgroundTransparency = 1
    MakeDraggable(TitleBar, MainFrame)

    local TitleLabel = Instance.new("TextLabel", TitleBar)
    TitleLabel.Size = UDim2.new(1, -90, 1, 0)
    TitleLabel.Position = UDim2.new(0, 20, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = titleText
    TitleLabel.TextColor3 = Theme.TextLight
    TitleLabel.TextSize = 16
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    local CloseBtn = Instance.new("TextButton", TitleBar)
    CloseBtn.Size = UDim2.new(0, 40, 1, 0)
    CloseBtn.Position = UDim2.new(1, -40, 0, 0)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "✕"
    CloseBtn.TextColor3 = Theme.TextDark
    CloseBtn.TextSize = 16
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.MouseButton1Click:Connect(function() PlayClick(); ScreenGui:Destroy() end)
    CloseBtn.MouseEnter:Connect(function() CreateTween(CloseBtn, {TextColor3 = Theme.Accent}) end)
    CloseBtn.MouseLeave:Connect(function() CreateTween(CloseBtn, {TextColor3 = Theme.TextDark}) end)

    local MinBtn = Instance.new("TextButton", TitleBar)
    MinBtn.Size = UDim2.new(0, 40, 1, 0)
    MinBtn.Position = UDim2.new(1, -80, 0, 0)
    MinBtn.BackgroundTransparency = 1
    MinBtn.Text = "−"
    MinBtn.TextColor3 = Theme.TextDark
    MinBtn.TextSize = 22
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.MouseEnter:Connect(function() CreateTween(MinBtn, {TextColor3 = Theme.TextLight}) end)
    MinBtn.MouseLeave:Connect(function() CreateTween(MinBtn, {TextColor3 = Theme.TextDark}) end)

    -- حبة الدواء
    local PillBtn = Instance.new("TextButton", ScreenGui)
    PillBtn.Size = UDim2.new(0, 130, 0, 38)
    PillBtn.Position = UDim2.new(0.5, -65, 0, 20)
    PillBtn.BackgroundColor3 = Theme.MainBg
    PillBtn.Text = "💊 COMMANDER"
    PillBtn.TextColor3 = Theme.TextLight
    PillBtn.TextSize = 12
    PillBtn.Font = Enum.Font.GothamBold
    PillBtn.Visible = false
    PillBtn.AutoButtonColor = false
    Instance.new("UICorner", PillBtn).CornerRadius = UDim.new(1, 0)
    local PillStroke = Instance.new("UIStroke", PillBtn)
    PillStroke.Color = Theme.Accent
    PillStroke.Thickness = 1.5
    MakeDraggable(PillBtn, PillBtn)

    MinBtn.MouseButton1Click:Connect(function()
        PlayClick()
        CreateTween(MainFrame, {Size = UDim2.new(0, 480, 0, 0)}, 0.2).Completed:Connect(function()
            MainFrame.Visible = false
            MainFrame.Size = UDim2.new(0, 480, 0, 380)
            PillBtn.Visible = true
            CreateTween(PillBtn, {BackgroundTransparency = 0}, 0.2)
        end)
    end)

    PillBtn.MouseButton1Click:Connect(function()
        PlayClick()
        CreateTween(PillBtn, {BackgroundTransparency = 1}, 0.1).Completed:Connect(function()
            PillBtn.Visible = false
            MainFrame.Size = UDim2.new(0, 480, 0, 0)
            MainFrame.Visible = true
            CreateTween(MainFrame, {Size = UDim2.new(0, 480, 0, 380)}, 0.2)
        end)
    end)

    -- اللوحة الجانبية
    local SidePanel = Instance.new("Frame", MainFrame)
    SidePanel.Size = UDim2.new(0, 140, 1, -50)
    SidePanel.Position = UDim2.new(0, 10, 0, 40)
    SidePanel.BackgroundColor3 = Theme.SideBg
    Instance.new("UICorner", SidePanel).CornerRadius = UDim.new(0, 8)
    Instance.new("UIStroke", SidePanel).Color = Theme.Stroke

    local TabContainer = Instance.new("ScrollingFrame", SidePanel)
    TabContainer.Size = UDim2.new(1, 0, 1, -10)
    TabContainer.Position = UDim2.new(0, 0, 0, 5)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 0
    local TabLayout = Instance.new("UIListLayout", TabContainer)
    TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Padding = UDim.new(0, 5)

    local ContentArea = Instance.new("Frame", MainFrame)
    ContentArea.Size = UDim2.new(1, -170, 1, -50)
    ContentArea.Position = UDim2.new(0, 160, 0, 40)
    ContentArea.BackgroundTransparency = 1

    local WindowObj = {}
    local ActiveTab = nil

    function WindowObj:Notify(config)
        PlayClick()
        local duration = config.Duration or 3
        local NotifHolder = Instance.new("Frame", NotifContainer)
        NotifHolder.Size = UDim2.new(1, 0, 0, 65)
        NotifHolder.BackgroundTransparency = 1
        NotifHolder.ClipsDescendants = true
        local NotifFrame = Instance.new("Frame", NotifHolder)
        NotifFrame.Size = UDim2.new(1, 0, 1, 0)
        NotifFrame.Position = UDim2.new(1, 0, 0, 0)
        NotifFrame.BackgroundColor3 = Theme.ElementBg
        Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 6)
        Instance.new("UIStroke", NotifFrame).Color = Theme.Accent
        local NTitle = Instance.new("TextLabel", NotifFrame)
        NTitle.Size = UDim2.new(1, -20, 0, 25)
        NTitle.Position = UDim2.new(0, 10, 0, 5)
        NTitle.BackgroundTransparency = 1
        NTitle.Text = config.Title or "Notification"
        NTitle.TextColor3 = Theme.TextLight
        NTitle.TextSize = 14
        NTitle.Font = Enum.Font.GothamBold
        NTitle.TextXAlignment = Enum.TextXAlignment.Left
        local NDesc = Instance.new("TextLabel", NotifFrame)
        NDesc.Size = UDim2.new(1, -20, 1, -30)
        NDesc.Position = UDim2.new(0, 10, 0, 25)
        NDesc.BackgroundTransparency = 1
        NDesc.Text = config.Content or "Message here."
        NDesc.TextColor3 = Theme.TextDark
        NDesc.TextSize = 12
        NDesc.Font = Enum.Font.Gotham
        NDesc.TextXAlignment = Enum.TextXAlignment.Left
        NDesc.TextWrapped = true
        CreateTween(NotifFrame, {Position = UDim2.new(0, 0, 0, 0)}, 0.3)
        task.delay(duration, function()
            local fadeOut = CreateTween(NotifFrame, {Position = UDim2.new(1, 10, 0, 0)}, 0.3)
            fadeOut.Completed:Connect(function() NotifHolder:Destroy() end)
        end)
    end

    function WindowObj:MakeTab(tabName)
        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(1, -16, 0, 32)
        TabBtn.Position = UDim2.new(0, 8, 0, 0)
        TabBtn.BackgroundColor3 = Theme.MainBg
        TabBtn.Text = tabName
        TabBtn.TextColor3 = Theme.TextDark
        TabBtn.TextSize = 13
        TabBtn.Font = Enum.Font.GothamSemibold
        TabBtn.AutoButtonColor = false
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

        local TabContent = Instance.new("ScrollingFrame", ContentArea)
        TabContent.Size = UDim2.new(1, 0, 1, 0)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.ScrollBarImageColor3 = Theme.Accent
        TabContent.Visible = false

        local ContentLayout = Instance.new("UIListLayout", TabContent)
        ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ContentLayout.Padding = UDim.new(0, 8)
        ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 10)
        end)

        TabBtn.MouseButton1Click:Connect(function()
            if ActiveTab == TabContent then return end
            PlayClick()
            for _, btn in pairs(TabContainer:GetChildren()) do
                if btn:IsA("TextButton") then
                    CreateTween(btn, {BackgroundColor3 = Theme.MainBg, TextColor3 = Theme.TextDark})
                end
            end
            if ActiveTab then ActiveTab.Visible = false end
            CreateTween(TabBtn, {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextLight})
            TabContent.Visible = true
            ActiveTab = TabContent
        end)

        if not WindowObj.FirstTab then
            WindowObj.FirstTab = TabBtn
            TabBtn.BackgroundColor3 = Theme.Accent
            TabBtn.TextColor3 = Theme.TextLight
            TabContent.Visible = true
            ActiveTab = TabContent
        end

        local TabObj = {}

        function TabObj:AddSection(name)
            local sec = Instance.new("TextLabel", TabContent)
            sec.Size = UDim2.new(1, 0, 0, 25)
            sec.BackgroundTransparency = 1
            sec.Text = "  " .. name
            sec.TextColor3 = Theme.Accent
            sec.TextSize = 13
            sec.Font = Enum.Font.GothamBold
            sec.TextXAlignment = Enum.TextXAlignment.Left
        end

        function TabObj:AddButton(config)
            local btn = Instance.new("TextButton", TabContent)
            btn.Size = UDim2.new(1, -10, 0, 38)
            btn.BackgroundColor3 = Theme.ElementBg
            btn.Text = config.Name
            btn.TextColor3 = Theme.TextLight
            btn.TextSize = 13
            btn.Font = Enum.Font.GothamBold
            btn.AutoButtonColor = false
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
            btn.MouseEnter:Connect(function() CreateTween(btn, {BackgroundColor3 = Theme.ElementHover}) end)
            btn.MouseLeave:Connect(function() CreateTween(btn, {BackgroundColor3 = Theme.ElementBg}) end)
            btn.MouseButton1Click:Connect(function()
                PlayClick()
                if config.Callback then config.Callback() end
            end)
        end

        function TabObj:AddToggle(config)
            local frame = Instance.new("Frame", TabContent)
            frame.Size = UDim2.new(1, -10, 0, 40)
            frame.BackgroundColor3 = Theme.ElementBg
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

            local label = Instance.new("TextLabel", frame)
            label.Size = UDim2.new(1, -80, 1, 0)
            label.Position = UDim2.new(0, 10, 0, 0)
            label.BackgroundTransparency = 1
            label.Text = config.Name
            label.TextColor3 = Theme.TextLight
            label.TextSize = 13
            label.Font = Enum.Font.GothamSemibold
            label.TextXAlignment = Enum.TextXAlignment.Left

            local toggleBtn = Instance.new("TextButton", frame)
            toggleBtn.Size = UDim2.new(0, 60, 0, 24)
            toggleBtn.Position = UDim2.new(1, -75, 0.5, -12)
            local state = config.Default or false
            toggleBtn.BackgroundColor3 = state and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(200, 60, 60)
            toggleBtn.Text = state and "ON" or "OFF"
            toggleBtn.TextColor3 = Theme.TextLight
            toggleBtn.TextSize = 12
            toggleBtn.Font = Enum.Font.GothamBold
            Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 4)

            toggleBtn.MouseButton1Click:Connect(function()
                PlayClick()
                state = not state
                CreateTween(toggleBtn, {BackgroundColor3 = state and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(200, 60, 60)}, 0.2)
                toggleBtn.Text = state and "ON" or "OFF"
                if config.Callback then config.Callback(state) end
            end)
        end

        -- إصلاح كامل لشريط التمرير
        function TabObj:AddSlider(config)
            local frame = Instance.new("Frame", TabContent)
            frame.Size = UDim2.new(1, -10, 0, 55)
            frame.BackgroundColor3 = Theme.ElementBg
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

            local title = Instance.new("TextLabel", frame)
            title.Size = UDim2.new(1, -20, 0, 25)
            title.Position = UDim2.new(0, 10, 0, 5)
            title.BackgroundTransparency = 1
            title.Text = config.Name
            title.TextColor3 = Theme.TextLight
            title.TextSize = 13
            title.Font = Enum.Font.GothamSemibold
            title.TextXAlignment = Enum.TextXAlignment.Left

            local valLabel = Instance.new("TextLabel", frame)
            valLabel.Size = UDim2.new(0, 50, 0, 25)
            valLabel.Position = UDim2.new(1, -60, 0, 5)
            valLabel.BackgroundTransparency = 1
            valLabel.TextColor3 = Theme.Accent
            valLabel.TextSize = 13
            valLabel.Font = Enum.Font.GothamBold
            valLabel.TextXAlignment = Enum.TextXAlignment.Right

            local bg = Instance.new("Frame", frame)
            bg.Size = UDim2.new(1, -20, 0, 6)
            bg.Position = UDim2.new(0, 10, 0, 35)
            bg.BackgroundColor3 = Theme.MainBg
            bg.AutoButtonColor = false
            Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 3)

            local fill = Instance.new("Frame", bg)
            fill.BackgroundColor3 = Theme.Accent
            Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

            local minVal = config.Min or 0
            local maxVal = config.Max or 100
            local defaultVal = config.Default or minVal

            local function updateUI(value)
                local clamped = math.clamp(value, minVal, maxVal)
                local percent = (clamped - minVal) / (maxVal - minVal)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                valLabel.Text = tostring(clamped)
                if config.Callback then
                    pcall(config.Callback, clamped)
                end
            end

            local dragging = false
            local function onInput(input)
                if not bg or not bg.Parent then return end
                -- ننتظر حتى يكون الحجم معلوماً
                local bgSize = bg.AbsoluteSize.X
                if bgSize == 0 then return end
                local relativeX = math.clamp(input.Position.X - bg.AbsolutePosition.X, 0, bgSize)
                local percent = relativeX / bgSize
                local newValue = minVal + (maxVal - minVal) * percent
                newValue = math.floor(newValue + 0.5)
                updateUI(newValue)
            end

            bg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    PlayClick()
                    onInput(input)
                end
            end)

            bg.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            bg.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    onInput(input)
                end
            end)

            -- تحديث عند تغيير حجم الإطار
            local function refreshFill()
                if bg and bg.AbsoluteSize.X > 0 then
                    local currentVal = tonumber(valLabel.Text) or defaultVal
                    local percent = (currentVal - minVal) / (maxVal - minVal)
                    fill.Size = UDim2.new(percent, 0, 1, 0)
                end
            end
            bg:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshFill)
            frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshFill)

            updateUI(defaultVal)
        end

        function TabObj:AddDropdown(config)
            local dropFrame = Instance.new("Frame", TabContent)
            dropFrame.Size = UDim2.new(1, -10, 0, 38)
            dropFrame.BackgroundColor3 = Theme.ElementBg
            dropFrame.ClipsDescendants = true
            Instance.new("UICorner", dropFrame).CornerRadius = UDim.new(0, 6)

            local dropBtn = Instance.new("TextButton", dropFrame)
            dropBtn.Size = UDim2.new(1, 0, 0, 38)
            dropBtn.BackgroundTransparency = 1
            dropBtn.Text = "  " .. config.Name .. " : " .. (config.Default or "Select")
            dropBtn.TextColor3 = Theme.TextLight
            dropBtn.TextSize = 13
            dropBtn.Font = Enum.Font.GothamSemibold
            dropBtn.TextXAlignment = Enum.TextXAlignment.Left

            local icon = Instance.new("TextLabel", dropFrame)
            icon.Size = UDim2.new(0, 30, 0, 38)
            icon.Position = UDim2.new(1, -30, 0, 0)
            icon.BackgroundTransparency = 1
            icon.Text = "▼"
            icon.TextColor3 = Theme.TextDark
            icon.TextSize = 12

            local dropScroll = Instance.new("ScrollingFrame", dropFrame)
            dropScroll.Size = UDim2.new(1, -10, 0, 100)
            dropScroll.Position = UDim2.new(0, 5, 0, 40)
            dropScroll.BackgroundTransparency = 1
            dropScroll.ScrollBarThickness = 2
            local dropLayout = Instance.new("UIListLayout", dropScroll)
            dropLayout.Padding = UDim.new(0, 2)

            local isOpen = false
            dropBtn.MouseButton1Click:Connect(function()
                PlayClick()
                isOpen = not isOpen
                local targetHeight = isOpen and (45 + math.min(#config.Options * 25, 100)) or 38
                CreateTween(dropFrame, {Size = UDim2.new(1, -10, 0, targetHeight)})
                CreateTween(icon, {Rotation = isOpen and 180 or 0})
            end)

            for _, opt in pairs(config.Options) do
                local optBtn = Instance.new("TextButton", dropScroll)
                optBtn.Size = UDim2.new(1, 0, 0, 25)
                optBtn.BackgroundColor3 = Theme.MainBg
                optBtn.Text = opt
                optBtn.TextColor3 = Theme.TextDark
                optBtn.TextSize = 12
                optBtn.Font = Enum.Font.Gotham
                Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
                optBtn.MouseButton1Click:Connect(function()
                    PlayClick()
                    dropBtn.Text = "  " .. config.Name .. " : " .. opt
                    isOpen = false
                    CreateTween(dropFrame, {Size = UDim2.new(1, -10, 0, 38)})
                    CreateTween(icon, {Rotation = 0})
                    if config.Callback then config.Callback(opt) end
                end)
            end
            dropScroll.CanvasSize = UDim2.new(0, 0, 0, dropLayout.AbsoluteContentSize.Y)
        end

        return TabObj
    end

    return WindowObj
end

return CommanderLib
