    local arrow = Create("TextLabel", {
        Position = UDim2.new(1, -22, 0, 15),
        Size = UDim2.fromOffset(12, 12),
        BackgroundTransparency = 1,
        Text = "▼",
        TextSize = 9,
        TextColor3 = Theme.SubText,
        Font = Enum.Font.GothamBold,
        ZIndex = 2,
        Parent = container,
    })

    local list = Create("ScrollingFrame", {
        Position = UDim2.new(0, 8, 0, 42),
        Size = UDim2.new(1, -16, 0, 0),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Visible = false,
        ClipsDescendants = true,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.30,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 4,
        Parent = container,
    })
    Corner(list, 8)
    Stroke(list)
    Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        Parent = list,
    })

    local expanded = false
    local function SetOpen(open)
        if expanded == open then return end
        expanded = open
        Tween(arrow, TI_Fast, { Rotation = open and 180 or 0 })
        if open then
            list.Visible = true
            Tween(container, TI_Smooth, { Size = UDim2.new(1, 0, 0, collapsed + 6 + listHeight) })
            Tween(list, TI_Smooth, { Size = UDim2.new(1, -16, 0, listHeight) })
        else
            Tween(container, TI_Fast, { Size = UDim2.new(1, 0, 0, collapsed) })
            local tw = Tween(list, TI_Fast, { Size = UDim2.new(1, -16, 0, 0) })
            tw.Completed:Once(function()
                if not expanded then
                    list.Visible = false
                end
            end)
        end
    end

    local optionButtons = {}
    local function RefreshOptionColors()
        for option, button in pairs(optionButtons) do
            local isSelected = (option == selected)
            Tween(button, TI_Fast, {
                BackgroundColor3 = isSelected and Theme.Accent or Theme.ElementHover,
                BackgroundTransparency = isSelected and 0.20 or 0.25,
                TextColor3 = isSelected and Theme.Text or Theme.SubText,
            })
        end
    end

    for index, option in ipairs(options) do
        local optBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundColor3 = Theme.ElementHover,
            BackgroundTransparency = 0.25,
            Text = tostring(option),
            TextColor3 = Theme.SubText,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = index,
            Parent = list,
        })
        Corner(optBtn, 6)
        Create("UIPadding", { PaddingLeft = UDim.new(0, 8), Parent = optBtn })
        optionButtons[option] = optBtn

        optBtn.MouseButton1Click:Connect(function()
            selected = option
            ddBtn.Text = tostring(option)
            RefreshOptionColors()
            SetOpen(false)
            if callback then
                local ok, err = pcall(callback, option)
                if not ok then warn("[Aurora] Dropdown callback error: " .. tostring(err)) end
            end
        end)
    end

    ddBtn.MouseButton1Click:Connect(function()
        SetOpen(not expanded)
    end)
    RefreshOptionColors()

    local handle = {}
    handle.Container = container
    handle.Set = function(option)
        if table.find(options, option) then
            selected = option
            ddBtn.Text = tostring(option)
            RefreshOptionColors()
        end
    end
    handle.Get = function() return selected end
    RegisterConfigurable(self, name, "Dropdown", handle.Get, handle.Set)
    return handle
end

