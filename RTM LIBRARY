function TabMethods:AddToggle(text, default, callback)
    local window = self.Window
    if not window or window.Destroyed then return nil end
    if type(default) == "function" then
        callback, default = default, false
    end

    local container = CreateElement(self.Container, NextOrder(self), ELEMENT_HEIGHT, window)
    CreateRowLabel(container, text, 64, window)

    local track = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(38, 20),
        BackgroundColor3 = Theme.ElementHover,
        BackgroundTransparency = 0.10,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Parent = container,
    })
    Corner(track, 10)
    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.fromRGB(240, 240, 246),
        BorderSizePixel = 0,
        Parent = track,
    })
    Corner(knob, 7)

    local state = default == true
    local function Render()
        Tween(track, TI_Smooth, { BackgroundColor3 = state and Theme.Accent or Theme.ElementHover })
        Tween(knob, TI_Smooth, { Position = UDim2.new(0, state and 21 or 3, 0.5, 0) })
    end
    local function Set(value, fire)
        value = value == true
        if value == state then return end
        state = value
        Render()
        if fire ~= false and type(callback) == "function" then
            local ok, err = pcall(callback, state)
            if not ok then warn("[Aurora] Toggle error: " .. tostring(err)) end
        end
    end
    track.BackgroundColor3 = state and Theme.Accent or Theme.ElementHover
    knob.Position = UDim2.new(0, state and 21 or 3, 0.5, 0)

    table.insert(window._themeUpdaters, function(accent)
        if state then Tween(track, TI_Fast, { BackgroundColor3 = accent }) end
    end)

    track.MouseButton1Click:Connect(function()
        Set(not state)
    end)
    RegisterConfigurable(self, text, "Toggle",
        function() return state end,
        function(value) Set(value == true or value == "true", true) end)
    RegisterSearchItem(self, text, container)
    return { Set = Set, Get = function() return state end }
end

