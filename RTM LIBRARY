function Aurora:SaveConfig(folderName, fileName)
    if self.Destroyed then return false, "Window is destroyed" end
    if type(writefile) ~= "function" or type(readfile) ~= "function" then
        return false, "This executor does not support the file system"
    end

    folderName = tostring(folderName or "AuroraUI")
    fileName   = tostring(fileName or "config")

    local data = { WindowSize = {}, Elements = {} }
    local w, h = self:GetWindowSize()
    data.WindowSize = { w, h }
    for key, entry in pairs(self.Registry) do
        local ok, value = pcall(entry.Get)
        if ok and value ~= nil then
            data.Elements[key] = value
        end
    end

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not ok then
        return false, "Failed to encode config"
    end

    pcall(function()
        if type(makefolder) == "function" then
            makefolder(folderName)
        end
    end)
    local path = folderName .. "/" .. fileName .. ".json"
    local wrote = pcall(writefile, path, encoded)
    return wrote, wrote and path or "Failed to write file"
end

function Aurora:LoadConfig(folderName, fileName)
    if self.Destroyed then return false, "Window is destroyed" end
    if type(readfile) ~= "function" then
        return false, "This executor does not support the file system"
    end
    folderName = tostring(folderName or "AuroraUI")
    fileName   = tostring(fileName or "config")
    local path = folderName .. "/" .. fileName .. ".json"

    local ok, content = pcall(readfile, path)
    if not ok or type(content) ~= "string" or content == "" then
        return false, "No config found"
    end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)
    if not okDecode or type(data) ~= "table" then
        return false, "Corrupted config"
    end

    for key, value in pairs(data.Elements or {}) do
        local entry = self.Registry[key]
        if entry and type(entry.Set) == "function" then
            pcall(entry.Set, value)
        end
    end

    if type(data.WindowSize) == "table" then
        self:SetWindowSize(data.WindowSize[1], data.WindowSize[2])
    end
    return true
end

