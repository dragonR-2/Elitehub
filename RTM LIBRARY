local TI_Click  = TweenInfo.new(0.10, Enum.EasingStyle.Quad,     Enum.EasingDirection.Out)
local TI_Fast   = TweenInfo.new(0.15, Enum.EasingStyle.Quad,     Enum.EasingDirection.Out)
local TI_Smooth = TweenInfo.new(0.22, Enum.EasingStyle.Circular, Enum.EasingDirection.Out)

local function Create(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for key, value in pairs(props) do
        inst[key] = value
    end
    inst.Parent = parent
    return inst
end

local function Corner(parent, radius)
    return Create("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

local function Stroke(parent, color, transparency, thickness)
    return Create("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0.85,
        Parent = parent,
    })
end

local function Tween(inst, info, goal)
    local tw = TweenService:Create(inst, info, goal)
    tw:Play()
    return tw
end

local function BindHover(button, base, hover, pressed)
    button.MouseEnter:Connect(function()
        Tween(button, TI_Fast, { BackgroundColor3 = hover })
    end)
    button.MouseLeave:Connect(function()
        Tween(button, TI_Fast, { BackgroundColor3 = base })
    end)
    if pressed then
        button.MouseButton1Down:Connect(function()
            Tween(button, TI_Click, { BackgroundColor3 = pressed })
        end)
        button.MouseButton1Up:Connect(function()
            Tween(button, TI_Fast, { BackgroundColor3 = hover })
        end)
    end
end

local function NextOrder(tab)
    tab._order = (tab._order or 0) + 1
    return tab._order
end

-- ربط عنصر بالنظام الحي للثيمات (يتغير تلقائياً عند تبديل الثيم)
local function BindTheme(window, object, property, key)
    table.insert(window._themeBindings, { Object = object, Property = property, Key = key })
    return object
end

local function CreateElement(page, order, height, window)
    local container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        LayoutOrder = order,
        Parent = page,
    })
    Corner(container, 8) -- Fluent radius
    Stroke(container)
    if window then BindTheme(window, container, "BackgroundColor3", "Element") end
    return container
end

local function CreateRowLabel(container, text, rightReserve, window)
    local label = Create("TextLabel", {
        Size = UDim2.new(1, -(rightReserve or 90), 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = container,
    })
    if window then BindTheme(window, label, "TextColor3", "Text") end
    return label
end

local function ToAssetId(value)
    if type(value) == "number" and value > 0 then
        return "rbxassetid://" .. tostring(math.floor(value))
    elseif type(value) == "string" and value ~= "" then
        if string.sub(value, 1, 10) == "rbxassetid" or string.sub(value, 1, 9) == "rbxasset:" then
            return value
        end
        return "rbxassetid://" .. value
    end
    return nil
end

local function CopyToClipboard(text)
    if type(setclipboard) == "function" then
        return pcall(setclipboard, text)
    elseif type(toclipboard) == "function" then
        return pcall(toclipboard, text)
    elseif type(clipboard) == "table" and type(clipboard.set) == "function" then
        return pcall(clipboard.set, text)
    end
    return false
end

local function RegisterConfigurable(tab, name, itemType, getFn, setFn)
    local window = tab and tab.Window
    if not window or not window.Registry or window.Destroyed then return end
    local baseKey = tostring(tab.Name) .. "/" .. tostring(name)
    local key = baseKey
    local suffix = 2
    while window.Registry[key] do
        key = baseKey .. "#" .. tostring(suffix)
        suffix += 1
    end
    window.Registry[key] = { Type = itemType, Get = getFn, Set = setFn }
end

local function RegisterSearchItem(tab, text, frame)
    if tab and tab.SearchItems and frame then
        table.insert(tab.SearchItems, {
            Name  = string.lower(tostring(text or "")),
            Frame = frame,
        })
    end
end

