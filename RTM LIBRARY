--──────────────────────────── أدوات مساعدة ────────────────────────────
local TI_Click  = TweenInfo.new(0.10, Enum.EasingStyle.Quad,     Enum.EasingDirection.Out)
local TI_Fast   = TweenInfo.new(0.15, Enum.EasingStyle.Quad,     Enum.EasingDirection.Out)
local TI_Smooth = TweenInfo.new(0.26, Enum.EasingStyle.Circular, Enum.EasingDirection.Out)

local function Create(class, props)
    local inst = Instance.new(class)
    local parent = props.Parent
    props.Parent = nil
    for key, value in pairs(props) do
        inst[key] = value
    end
    inst.Parent = parent -- الـ Parent دائماً الأخير لأداء أفضل
    return inst
end

local function Corner(parent, radius)
    return Create("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

local function Stroke(parent, color, transparency, thickness)
    return Create("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0.90,
        Parent = parent,
    })
end

-- تدرج لوني مساعد (استخدام داخلي فقط)
local function Gradient(parent, rotation, fromColor, toColor, transparencySeq)
    local props = {
        Rotation = rotation or 90,
        Color = ColorSequence.new(fromColor, toColor),
        Parent = parent,
    }
    if transparencySeq then
        props.Transparency = transparencySeq
    end
    return Create("UIGradient", props)
end

local function Tween(inst, info, goal)
    local tw = TweenService:Create(inst, info, goal)
    tw:Play()
    return tw
end

-- تأثير تمرير/ضغط موحد (ماوس + لمس)
local function BindHover(button, base, hover, pressed)
    button.MouseEnter:Connect(function()
        Tween(button, TI_Fast, { BackgroundColor3 = hover })
    end)
    button.MouseLeave:Connect(function()
        Tween(button, TI_Fast, { BackgroundColor3 = base })
    end)
    if pressed then
        button.MouseButton1Down:Connect(function()
            Tween(button, TI_Click, { BackgroundColor3 = pressed })
        end)
        button.MouseButton1Up:Connect(function()
            Tween(button, TI_Fast, { BackgroundColor3 = hover })
        end)
    end
end

